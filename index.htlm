ired":false,"voice":""},{"type":"shape","target":"square","shapes":["circle","square","triangle","rectangle"],"prompt":"Tìm tất cả hình vuông.","id":"sgk1-19-3","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"shape","target":"rectangle","shapes":["circle","square","triangle","rectangle"],"prompt":"Tìm tất cả hình chữ nhật.","id":"sgk1-19-4","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"shape","target":"cube","shapes":["cube","cuboid","cube"],"prompt":"Tìm tất cả khối lập phương.","id":"sgk1-19-5","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"shape","target":"cuboid","shapes":["cube","cuboid","cuboid"],"prompt":"Tìm tất cả khối hộp chữ nhật.","id":"sgk1-19-6","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""}],"example":["circle","square","triangle","rectangle"],"version":0,"source":"SGK Toán 1, tập một-mau.pdf; mục lục trang 4–5. Nhiệm vụ được biên soạn mới để ôn tập."},{"id":"sgk-t1-20","book":"Toán 1 – Kết nối tri thức với cuộc sống","edition":"Theo bản PDF giáo viên cung cấp","volume":"Tập 1","number":"20","title":"Ôn tập chung","pages":"112–113","order":20,"classId":"","min":0,"max":10,"goal":"Đọc kỹ yêu cầu; chọn cách đếm, so sánh, thêm bớt hoặc nhận dạng phù hợp.","intro":"Cùng ôn các số, phép cộng và phép trừ trong phạm vi 10, các hình phẳng và hình khối đã học.","recap":"Đọc kỹ yêu cầu; chọn cách đếm, so sánh, thêm bớt hoặc nhận dạng phù hợp.","outside":"Tìm và đếm một số đồ vật hoặc hình tương tự quanh bạn. Nhờ cô hướng dẫn nếu cần.","english":[{"en":"Well done!","vi":"Bạn làm tốt lắm!"}],"englishApproved":false,"tasks":[{"type":"count","a":7,"mode":"choose","prompt":"Đếm số cà rốt rồi chọn số phù hợp.","id":"sgk1-20-1","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"compare","a":8,"b":6,"compareMode":"symbols","prompt":"Chọn dấu thích hợp giữa hai số.","id":"sgk1-20-2","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"operation","a":4,"b":3,"op":"+","prompt":"Thêm cà rốt rồi chọn kết quả.","id":"sgk1-20-3","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"operation","a":9,"b":5,"op":"-","prompt":"Bớt cà rốt rồi chọn số còn lại.","id":"sgk1-20-4","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"shape","target":"triangle","shapes":["circle","square","triangle","rectangle"],"prompt":"Tìm tất cả hình tam giác.","id":"sgk1-20-5","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"shape","target":"cube","shapes":["cube","cuboid","cube"],"prompt":"Tìm tất cả khối lập phương.","id":"sgk1-20-6","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"sequence","seq":[3,4,5,6,7],"missing":2,"prompt":"Tìm số còn thiếu để giúp Thỏ về nhà.","id":"sgk1-20-7","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"split","a":4,"b":6,"find":"part","prompt":"Tìm số cà rốt của nhóm còn thiếu.","id":"sgk1-20-8","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""}],"example":[],"version":0,"source":"SGK Toán 1, tập một-mau.pdf; mục lục trang 4–5. Nhiệm vụ được biên soạn mới để ôn tập."}];

function puzzleSVG(target,n){return `<svg viewBox="0 0 220 120" width="220" height="150" role="img" aria-label="Khung ghép ${n} trên 2 mảnh"><rect x="40" y="10" width="${target==='square'?100:160}" height="${target==='square'?100:80}" fill="#f6f6ed" stroke="#4b8074" stroke-width="3" stroke-dasharray="5 5"/>${target==='square'?`${n>=1?'<path d="M40 10 H140 V110Z" fill="#8ac6cb" stroke="#34717c" stroke-width="2"/>':''}${n>=2?'<path d="M40 10 L140 110 H40Z" fill="#f2bc68" stroke="#a56c2c" stroke-width="2"/>':''}`:`${n>=1?'<rect x="40" y="10" width="80" height="80" fill="#8ac6cb" stroke="#34717c" stroke-width="2"/>':''}${n>=2?'<rect x="120" y="10" width="80" height="80" fill="#f2bc68" stroke="#a56c2c" stroke-width="2"/>':''}`}</svg>`;}
BOOK[1].example=Array(6).fill('carrot');
function installBook(){if(!teacher)return;const classId=$('bankClass').value;if(!classId)return toast('Hãy tạo và chọn lớp trước.');let n=0;for(const base of BOOK){if(db.lessons.some(l=>l.sourceKey===base.id&&l.sourceClass===classId))continue;const lesson=clone(base);lesson.id=uid();lesson.classId=classId;lesson.tasks.forEach(t=>t.id=uid());db.lessons.push({id:lesson.id,sourceKey:base.id,sourceClass:classId,draft:lesson,history:[],published:null,hidden:false});n++;}save();render();toast(n?'Đã thêm '+n+' bản nháp. Cô xem trước và duyệt từng bài nhé.':'Lớp này đã có đủ 20 bản nháp từ SGK.');}


const ENGLISH_PACKS={"1":[{"en":"one","vi":"một"},{"en":"two","vi":"hai"},{"en":"three","vi":"ba"}],"2":[{"en":"six","vi":"sáu"},{"en":"eight","vi":"tám"},{"en":"ten","vi":"mười"}],"3":[{"en":"more","vi":"nhiều hơn"},{"en":"fewer","vi":"ít hơn"},{"en":"the same number","vi":"số lượng bằng nhau"}],"4":[{"en":"greater than","vi":"lớn hơn"},{"en":"less than","vi":"bé hơn"},{"en":"equal to","vi":"bằng"}],"5":[{"en":"group","vi":"nhóm"},{"en":"together","vi":"cùng nhau"},{"en":"Let’s count!","vi":"Cùng đếm nào!"}],"6":[{"en":"Let’s count!","vi":"Cùng đếm nào!"},{"en":"Try again.","vi":"Bạn thử lại nhé."},{"en":"Well done!","vi":"Bạn làm tốt lắm!"}],"7":[{"en":"circle","vi":"hình tròn"},{"en":"square","vi":"hình vuông"},{"en":"triangle","vi":"hình tam giác"}],"8":[{"en":"triangle","vi":"hình tam giác"},{"en":"square","vi":"hình vuông"},{"en":"rectangle","vi":"hình chữ nhật"}],"9":[{"en":"circle","vi":"hình tròn"},{"en":"triangle","vi":"hình tam giác"},{"en":"rectangle","vi":"hình chữ nhật"}],"10":[{"en":"add","vi":"thêm vào"},{"en":"How many?","vi":"Có bao nhiêu?"},{"en":"Let’s count!","vi":"Cùng đếm nào!"}],"11":[{"en":"take away","vi":"bớt đi"},{"en":"How many are left?","vi":"Còn lại bao nhiêu?"},{"en":"Try again.","vi":"Bạn thử lại nhé."}],"12":[{"en":"add","vi":"thêm vào"},{"en":"take away","vi":"bớt đi"},{"en":"Well done!","vi":"Bạn làm tốt lắm!"}],"13":[{"en":"add","vi":"thêm vào"},{"en":"take away","vi":"bớt đi"},{"en":"How many?","vi":"Có bao nhiêu?"}],"14":[{"en":"cube","vi":"khối lập phương"},{"en":"cuboid","vi":"khối hộp chữ nhật"},{"en":"Find the cube.","vi":"Tìm khối lập phương."}],"15":[{"en":"left","vi":"bên trái"},{"en":"right","vi":"bên phải"},{"en":"between","vi":"ở giữa"}],"16":[{"en":"above","vi":"ở trên"},{"en":"below","vi":"ở dưới"},{"en":"between","vi":"ở giữa"}],"17":[{"en":"eight","vi":"tám"},{"en":"nine","vi":"chín"},{"en":"ten","vi":"mười"}],"18":[{"en":"add","vi":"thêm vào"},{"en":"take away","vi":"bớt đi"},{"en":"Well done!","vi":"Bạn làm tốt lắm!"}],"19":[{"en":"circle","vi":"hình tròn"},{"en":"square","vi":"hình vuông"},{"en":"cube","vi":"khối lập phương"}],"20":[{"en":"Let’s count!","vi":"Cùng đếm nào!"},{"en":"Find the shape.","vi":"Tìm hình nào."},{"en":"Well done!","vi":"Bạn làm tốt lắm!"}]};
for(const lesson of BOOK){lesson.english=clone(ENGLISH_PACKS[lesson.number]||[]);lesson.englishRevision=2;}
function isBookLesson(l){return Boolean(l.builtIn||String(l.id).startsWith('sgk-t1-')||String(l.source||'').includes('SGK Toán 1, tập một-mau.pdf'));}
function englishItems(l){if(!l)return [];if(isBookLesson(l)&&l.englishRevision!==2)return ENGLISH_PACKS[l.number]||[];if(isBookLesson(l)||l.englishApproved)return l.english||[];return [];}
function toggleEnglish(value){english=Boolean(value);db.settings.englishEnabled=english;stopAudio();save();render();}
function englishPanel(l,compact=false,t=null,done=false,r=null){const words=englishItems(l);if(!words.length)return '';const item=englishContext(l,t,done,r);return `<section class="english-strip" aria-label="Làm quen tiếng Anh"><div class="english-strip-top"><span class="english-label">🌎 Tiếng Anh nhỏ</span><label class="english-toggle"><input type="checkbox" ${english?'checked':''} onchange="toggleEnglish(this.checked)" aria-label="Bật tiếng Anh"><span>EN</span></label></div>${english?`<div class="english-now"><b lang="en">${esc(item.en)}</b><span>${esc(item.vi)}</span></div><div class="english-actions">${btn('🔊 Nghe','playEnglishContext()','small english-listen')}${btn('📖 Từ vựng','openEnglishVocabulary()','small ghost')}</div>`:'<small>Đã tắt. Bạn tiếp tục làm Toán nhé!</small>'}</section>`;}
function sayEnglish(item,kind='word'){if(!english||!run)return;stopAudio();toast(item.en+' — '+item.vi);if(!('speechSynthesis' in window)){toast('Thiết bị chưa hỗ trợ giọng đọc. Từ tiếng Anh và nghĩa tiếng Việt vẫn hiện trên màn hình.');return;}const vs=voices('en'),voice=vs.find(v=>v.lang==='en-GB')||vs.find(v=>v.lang==='en-US')||vs[0];if(!voice){speechSynthesis.getVoices();toast('Chưa có giọng tiếng Anh trên thiết bị. Bạn vẫn xem được từ và nghĩa; có thể mở file bằng Chrome/Edge và thử lại nút Nghe.');return;}const learningRun=run,wasPreview=preview,u=new SpeechSynthesisUtterance(item.en);u.voice=voice;u.lang=voice.lang;u.rate=.8;u.onend=()=>{if(!wasPreview){learningRun.englishEvents.push({at:new Date().toISOString(),text:item.en,kind,status:'finished'});save();}};u.onerror=()=>toast('Chưa phát được tiếng Anh. Hãy kiểm tra âm lượng hoặc kết nối mạng rồi bấm Nghe lại.');speechSynthesis.speak(u);}
function playEnglishWord(i){const words=run?englishItems(run.lesson):[];if(words[i])sayEnglish(words[i]);}
function playEnglishFeedback(correct){sayEnglish(correct?{en:'Well done!',vi:'Bạn làm tốt lắm!'}:{en:'Try again.',vi:'Bạn thử lại nhé.'},'feedback');}


const SHEETS_ENDPOINT='https://script.google.com/macros/s/AKfycbwJS5kKbh4iLRow5fOFWGwlpUffi7VZ_ZoB9qMXdILvaqLptG8IR8_5iTdfJ_a2YCZT/exec';
const sheetBusy=new Set();
function canonicalLessonId(r){const l=r.lesson||{};return isBookLesson(l)?'sgk|'+l.volume+'|'+l.number:r.lessonId;}
function completedLessonCount(studentId){return new Set(db.runs.filter(r=>r.studentId===studentId&&r.status==='complete').map(canonicalLessonId)).size;}
function sheetSnapshot(){if(!student)return null;return {studentId:student.id,hoTen:student.name||'Bạn nhỏ',lop:student.classId?className(student.classId):'',soBaiDaOn:completedLessonCount(student.id)};}
function sheetSignature(data){return JSON.stringify([data.studentId,data.hoTen,data.lop,data.soBaiDaOn]);}
function latestSheetSubmission(snapshot){const signature=sheetSignature(snapshot);return (db.sheetSubmissions||[]).slice().reverse().find(x=>x.signature===signature);}
function sheetPanel(){if(!student||preview)return '';const snap=sheetSnapshot(),last=latestSheetSubmission(snap);let status='';if(last){if(last.state==='confirmed')status='Google đã xác nhận lưu.';else if(last.state==='opened_unconfirmed')status='Xem phản hồi Google ở thẻ mới để kiểm tra kết quả lưu.';else status='Lần gửi trước chưa có xác nhận. Cô kiểm tra KET QUA trước khi gửi lại.';}return `<section class="send-card" aria-label="Gửi kết quả cho cô"><div class="send-summary"><span class="send-icon">📬</span><div><b>Gửi kết quả cho cô</b><small>${esc(snap.hoTen)} · ${esc(snap.lop||'Chưa nhập lớp')} · ${snap.soBaiDaOn} bài đã hoàn thành</small></div></div><form action="${SHEETS_ENDPOINT}" method="post" enctype="application/x-www-form-urlencoded" target="_blank" rel="noopener" onsubmit="return submitSheetNative(event)"><input type="hidden" name="hoTen" value="${esc(snap.hoTen)}"><input type="hidden" name="lop" value="${esc(snap.lop)}"><input type="hidden" name="soBaiDaOn" value="${snap.soBaiDaOn}"><button id="sendSheetButton" type="submit" class="primary">Gửi kết quả ↗</button></form>${status?`<small class="send-status" role="status">${esc(status)}</small>`:''}<details class="send-details"><summary>Thông tin gửi</summary><p>Gửi họ tên, lớp, số bài đã hoàn thành đến KET QUA. Google tự ghi thời gian. Kết quả học vẫn lưu trên thiết bị.</p>${snap.soBaiDaOn===0?'<p>Chưa có bài hoàn thành: số bài gửi là 0.</p>':''}<a href="${SHEETS_ENDPOINT}" target="_blank" rel="noopener">Kiểm tra kết nối Google ↗</a></details></section>`;}
async function submitToSheets(){if(!student||preview)return;const snapshot=sheetSnapshot();if(sheetBusy.has(snapshot.studentId))return;const old=latestSheetSubmission(snapshot);if(old&&['sent_unconfirmed','confirmed'].includes(old.state)){toast('Bản tổng hợp này đã được gửi. Học thêm một bài để gửi kết quả mới nhé.');return;}if(typeof navigator!=='undefined'&&navigator.onLine===false){toast('Bạn đang mất mạng. Kết quả đã giữ trên thiết bị; khi có mạng hãy bấm gửi lại.');return;}if(typeof fetch!=='function'){toast('Trình duyệt chưa hỗ trợ gửi. Hãy mở file trong Chrome hoặc Edge có kết nối mạng.');return;}if(!Array.isArray(db.sheetSubmissions))db.sheetSubmissions=[];const submission={id:uid(),signature:sheetSignature(snapshot),...snapshot,at:new Date().toISOString(),state:'sending'};db.sheetSubmissions.push(submission);sheetBusy.add(snapshot.studentId);save();render();let timer=null;const controller=typeof AbortController!=='undefined'?new AbortController():null;if(controller)timer=setTimeout(()=>controller.abort(),20000);try{const body=new URLSearchParams({hoTen:snapshot.hoTen,lop:snapshot.lop,soBaiDaOn:String(snapshot.soBaiDaOn)});const options={method:'POST',mode:'no-cors',credentials:'omit',redirect:'follow',body};if(controller)options.signal=controller.signal;const response=await fetch(SHEETS_ENDPOINT,options);if(response.type==='opaque'||response.type==='opaqueredirect'){submission.state='sent_unconfirmed';}else if(!response.ok){submission.state='rejected';submission.message='Mã phản hồi '+response.status;}else{const answer=await response.json();if(answer.success===true){submission.state='confirmed';submission.serverTime=answer.thoiGian||'';}else{submission.state='rejected';submission.message=String(answer.message||'Apps Script chưa xác nhận lưu.');}}}catch(error){submission.state='uncertain';submission.message=error&&error.name==='AbortError'?'Quá thời gian chờ.':'Không đọc được kết quả gửi. Có thể do mạng hoặc quyền truy cập Apps Script.';}finally{if(timer)clearTimeout(timer);sheetBusy.delete(snapshot.studentId);save();if(student&&student.id===snapshot.studentId)render();}toast(submission.state==='confirmed'?'Google Sheets đã xác nhận lưu.':submission.state==='sent_unconfirmed'?'Đã gửi yêu cầu. Chưa có xác nhận lưu; cô kiểm tra tab KET QUA nhé.':submission.state==='rejected'?'Chưa lưu được. Cô kiểm tra quyền triển khai và Apps Script.':'Chưa xác nhận được. Kết quả học vẫn giữ trên thiết bị.');}
// A previous tab may have closed while a request was in flight. Do not resend automatically.
for(const item of db.sheetSubmissions||[]){if(item.state==='sending'){item.state='uncertain';item.message='Phiên trước đóng khi đang gửi.';}}


let nativeSendAt=0;
function submitSheetNative(event){if(!student||preview)return false;const snapshot=sheetSnapshot();if(typeof navigator!=='undefined'&&navigator.onLine===false){toast('Bạn đang mất mạng. Khi có mạng hãy gửi lại; kết quả vẫn giữ trên thiết bị.');return false;}if(Date.now()-nativeSendAt<1500){toast('Đang mở trang Google. Bạn chờ một chút nhé.');return false;}const form=event&&event.target;if(!form||typeof form.querySelector!=='function')return false;const values={hoTen:snapshot.hoTen,lop:snapshot.lop,soBaiDaOn:String(snapshot.soBaiDaOn)};for(const key of Object.keys(values)){const input=form.querySelector('[name="'+key+'"]');if(!input){toast('Biểu mẫu chưa sẵn sàng. Bạn mở lại trang kết quả nhé.');return false;}input.value=values[key];}nativeSendAt=Date.now();if(!Array.isArray(db.sheetSubmissions))db.sheetSubmissions=[];db.sheetSubmissions.push({id:uid(),signature:sheetSignature(snapshot),...snapshot,at:new Date().toISOString(),state:'opened_unconfirmed',transport:'form_post'});save();setTimeout(()=>{if(student&&student.id===snapshot.studentId){render();toast('Xem trang phản hồi của Google ở thẻ mới rồi quay lại học nhé.');}},0);return true;}


function englishContext(l,t=null,done=false,r=null){const words=englishItems(l);if(done)return {en:'Well done!',vi:'Bạn làm tốt lắm!'};if(r&&r.attempts>0)return {en:'Try again.',vi:'Bạn thử lại nhé.'};if(!t)return words[0]||{en:'Hello!',vi:'Xin chào!'};if(t.type==='operation')return words.find(w=>w.en===(t.op==='+'?'add':'take away'))||{en:'Let’s count!',vi:'Cùng đếm nào!'};if(t.type==='shape')return words.find(w=>w.en===t.target)||{en:'Find the shape.',vi:'Tìm hình nào.'};if(t.type==='sequence')return {en:'Find the number.',vi:'Tìm số nào.'};if(t.type==='puzzle')return {en:'Let’s build!',vi:'Cùng ghép hình nào!'};if(t.type==='count'||t.type==='split'){const numbers=['zero','one','two','three','four','five','six','seven','eight','nine','ten'];return words.find(w=>w.en===numbers[t.a])||{en:'Let’s count!',vi:'Cùng đếm nào!'};}return words[0]||{en:'Let’s play!',vi:'Cùng chơi nào!'};}
function playEnglishContext(){if(!run||!english)return;const t=page==='game'?run.lesson.tasks[run.index]:null;const r=page==='game'?record():null;sayEnglish(englishContext(run.lesson,t,Boolean(r&&r.done),r),'context');}
function openEnglishVocabulary(){if(!run||!english)return;const words=englishItems(run.lesson);$('modal').innerHTML=`<div class="row between"><h2>🌎 Góc từ vựng</h2>${btn('✕',"$('modal').close();stopAudio()",'small ghost')}</div><p class="muted">${esc(run.lesson.title)} · ${words.length} từ / cụm ngắn</p><div class="vocabulary-list">${words.map((w,i)=>`<div class="vocabulary-row"><div><b lang="en">${esc(w.en)}</b><span>${esc(w.vi)}</span></div>${btn('🔊 Nghe',`playEnglishWord(${i})`,'small ghost')}</div>`).join('')}</div><small>Giọng của thiết bị, có thể cần mạng. Không tính vào điểm Toán.</small><div style="margin-top:20px">${btn('Quay lại bài học',"$('modal').close();stopAudio()",'primary')}</div>`;$('modal').showModal();}

render();
</script></body></html>
