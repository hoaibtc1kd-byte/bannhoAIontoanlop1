<!doctype html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bạn nhỏ AI · Giao diện gọn, dễ học</title>
<style>
:root{--ink:#203f46;--muted:#5f777b;--green:#29775c;--mint:#e5f2e5;--cream:#fffaf0;--orange:#de712e;--line:#dce8df;--blue:#e4f3fb;--white:#fff;--shadow:0 12px 40px #2646390a}*{box-sizing:border-box}body{margin:0;font:17px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--cream);color:var(--ink)}button,input,select,textarea{font:inherit}button{cursor:pointer;min-height:56px;border:0;border-radius:18px;padding:12px 22px;font-weight:700;color:var(--ink);background:#edf3ee;transition:transform .15s}button:hover{transform:translateY(-2px)}button:disabled{opacity:.5;cursor:default;transform:none}button:focus-visible,a:focus-visible{outline:4px solid #e4a234;outline-offset:3px}.primary{background:var(--green);color:#fff}.orange{background:var(--orange);color:#fff}.ghost{background:transparent;border:1px solid var(--line)}.danger{color:#a02f2f;background:#fff0ef}.small{font-size:14px;padding:9px 14px;min-height:44px;border-radius:12px}input,select,textarea{width:100%;padding:13px 15px;border:1px solid #bdcec5;border-radius:14px;background:white;color:var(--ink);min-height:52px}input[type=checkbox]{width:22px;min-height:22px;height:22px;accent-color:var(--green)}input[type=file]{font-size:14px}textarea{min-height:100px;resize:vertical}label{display:block;font-weight:650;margin:12px 0 6px}h1,h2,h3,p{margin:0 0 14px}h1{font-size:clamp(32px,5vw,62px);line-height:1.12;letter-spacing:-1.6px}h2{font-size:28px;line-height:1.3}h3{font-size:20px}.muted,small{color:var(--muted)}small{font-size:14px}.wrap{max-width:1150px;margin:auto;padding:24px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid var(--line);padding-bottom:20px;margin-bottom:26px}.brand{font-size:22px;font-weight:850;letter-spacing:-.7px}.brand span{display:block;font-size:12px;font-weight:650;letter-spacing:2px;color:var(--green)}.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.between{justify-content:space-between}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,265px),1fr));gap:20px}.cols{display:grid;grid-template-columns:1.5fr 1fr;gap:25px}.panel,.card{background:#fff;border:1px solid var(--line);border-radius:26px;padding:26px;box-shadow:var(--shadow);margin-bottom:20px}.card{margin-bottom:0}.soft{background:var(--mint)}.blue{background:var(--blue)}.hero{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:36px;padding:28px 0 44px}.eyebrow{font-size:13px;color:var(--green);font-weight:800;letter-spacing:2px;text-transform:uppercase}.hero p{font-size:20px;max-width:540px}.rabbit-stage{background:radial-gradient(ellipse at center,#ebf5d8 0%,#eaf4e2 62%,transparent 63%);text-align:center;position:relative;padding:16px}.rabbit{width:240px;max-width:100%;height:260px;filter:drop-shadow(0 15px 9px #38665016)}.rabbit.mini{width:92px;height:100px;flex-shrink:0}.bubble{background:#fff;border:1px solid var(--line);padding:18px 24px;border-radius:22px;max-width:400px;margin:0 auto;color:var(--ink);font-weight:600}.badge{display:inline-block;background:var(--mint);color:var(--green);border-radius:30px;padding:5px 12px;font-size:13px;font-weight:750}.pill{background:#fff3de;color:#935516}.nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.nav button.active{background:var(--green);color:white}.notice{background:#fff4dd;border:1px solid #e9d4a8;padding:15px 20px;border-radius:16px;font-size:14px;margin-bottom:20px}.empty{text-align:center;padding:40px 20px;color:var(--muted)}.narrow{max-width:510px;margin:40px auto}.step{font-size:13px;font-weight:800;color:var(--green);letter-spacing:1px}.game{max-width:840px;margin:auto;text-align:center}.question{font-size:clamp(23px,4vw,34px);font-weight:800;margin:24px 0;line-height:1.4}.choices{display:flex;justify-content:center;flex-wrap:wrap;gap:16px;margin:24px 0}.choice{font-size:30px;background:#fff;border:2px solid #b4d4c0;min-width:82px;min-height:78px}.choice.selected{background:#d4eadb;border-color:var(--green)}.objects{display:flex;justify-content:center;flex-wrap:wrap;gap:9px;padding:18px;min-height:90px}.object{background:#fff8e8;font-size:29px;min-width:49px;min-height:53px;padding:3px 8px;border:2px solid transparent;border-radius:12px}.object.counted{border-color:var(--green);background:#e2f1e5}.object.removed{opacity:.2;text-decoration:line-through}.feedback{border-radius:18px;padding:17px;background:var(--mint);font-size:19px;font-weight:650;margin:20px 0}.feedback.warn{background:#fff2da}.numberline{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:12px;margin:25px 0}.tile{background:var(--blue);border-radius:18px;padding:14px;min-width:64px;font-size:29px;font-weight:750}.tile.missing{background:#fff1d7;border:2px dashed #deac6b}.progress{height:10px;background:#e5ede5;border-radius:20px;overflow:hidden;margin:18px 0}.progress div{height:100%;background:var(--green);transition:width .3s}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:14px}td,th{text-align:left;padding:12px 10px;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--muted);font-weight:650}.stat{font-size:36px;line-height:1.3;font-weight:800;color:var(--green)}.check{display:flex;align-items:center;gap:10px;font-weight:500}.hidden{display:none!important}.hr{border:0;border-top:1px solid var(--line);margin:24px 0}.taskcard{border:1px solid var(--line);border-radius:18px;padding:20px;margin:14px 0;background:#fcfdf9}.garden{display:flex;flex-wrap:wrap;gap:12px;padding:20px 0}.plant{padding:15px;border-radius:18px;background:var(--mint);text-align:center;max-width:190px}.plant b{font-size:40px;display:block}footer{text-align:center;color:var(--muted);font-size:13px;padding:28px 0}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:white;padding:15px 24px;border-radius:18px;max-width:92vw;z-index:20;box-shadow:0 8px 35px #0002}.shape{width:84px;height:84px;vertical-align:middle}.inlineform{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.note-list{padding-left:22px}.note-list li{margin:8px 0}dialog{max-width:650px;width:94%;border:1px solid var(--line);border-radius:26px;padding:28px;color:var(--ink)}dialog::backdrop{background:#203f4680}.error{color:#a02f2f}.chip{background:var(--blue);padding:6px 12px;border-radius:20px;font-size:14px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(max-width:700px){.wrap{padding:16px}.hero,.cols{grid-template-columns:1fr}.hero{gap:20px;padding:10px 0 24px}.hero h1{font-size:42px}.rabbit-stage{order:-1}.rabbit{height:180px;width:180px}.panel,.card{padding:20px;border-radius:20px}.top{align-items:flex-start}.brand{font-size:19px}.nav{gap:6px}.nav button{padding:10px 13px;font-size:14px}.choice{min-width:70px}h2{font-size:25px}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}button:hover{transform:none}}body.reduce *{transition:none!important;animation:none!important}button,input,select{touch-action:manipulation}

.english-panel{border:2px solid #c4e0ec;background:#eef8fd;border-radius:22px;padding:20px;margin:20px 0;text-align:left}.english-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.english-head h3{margin:0;color:#28647b}.english-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:12px;margin-top:15px}.english-word{background:white;border:1px solid #cfe2ea;border-radius:16px;padding:14px}.english-word strong{display:block;color:#255b70;font-size:24px;line-height:1.3;margin-bottom:6px}.english-word span{display:block;font-size:16px;color:#4a6d7c;margin-bottom:10px}.english-line{background:white;border-left:4px solid #6aafc5;border-radius:12px;padding:12px 16px;margin-top:14px}.english-head .check{margin:0}.english-head input{accent-color:#28647b}.english-word button{width:100%}

/* Compact classroom layout, revision 7 */
body{background:#f6f8ef;color:#24433f}.wrap{max-width:1160px}.top{border-color:#dce6d7}.brand{color:#24694f}.panel,.card{box-shadow:0 7px 24px #3b614908;border-color:#dee8da}.primary{background:#287256;box-shadow:0 4px 0 #1e5843}.primary:hover{background:#23664d}.primary:active{transform:translateY(2px);box-shadow:0 2px 0 #1e5843}.game{max-width:1040px}.play-screen .progress{height:7px;margin:8px 0 18px;background:#dfe8d9}.play-heading{display:flex;justify-content:space-between;gap:16px;align-items:center}.play-lesson{font-size:14px;color:#6a7e72;margin:7px 0 0}.step-counter{flex-shrink:0;font-size:26px;font-weight:850;color:#287256;background:#e8f0df;border-radius:16px;padding:6px 15px}.step-counter small{font-size:15px}.play-layout{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:20px;align-items:start}.play-card{min-width:0;border:1px solid #d6e4d1;border-radius:28px;background:white;padding:24px;box-shadow:0 8px 30px #32513d08}.question-head{display:flex;gap:12px;align-items:flex-start;text-align:left;margin-bottom:12px}.question-head h2{font-size:clamp(23px,3vw,29px);line-height:1.35;margin:2px 0 0;letter-spacing:-.5px}.question-mark{flex-shrink:0;display:grid;place-items:center;width:38px;height:38px;border-radius:13px;background:#fff0d4;color:#a35b22;font-size:24px;font-weight:850}.question-tools{display:flex;gap:8px;justify-content:flex-start;margin:4px 0 12px}.question-tools button{background:#f6f8f2;border-color:#dfe8dc;font-size:14px;min-height:44px}.visual-stage{background:#fafbf6;border:1px solid #ecf0e6;border-radius:20px;padding:14px 10px;min-height:110px;max-height:330px;overflow:auto;overscroll-behavior:contain}.visual-stage .objects{padding:8px;gap:8px;min-height:58px}.visual-stage .object{min-width:48px;min-height:52px;font-size:28px;padding:3px 8px;border-radius:13px}.visual-stage .object.counted{background:#d8edcf;border-color:#4a8757}.visual-stage .question{font-size:25px;margin:8px 0 12px}.visual-stage .row{gap:8px}.visual-stage .row button{font-size:15px;min-height:48px;padding:10px 15px}.visual-stage .choices{margin:8px 0;gap:10px}.visual-stage .shape{width:65px;height:65px}.visual-stage .choice{padding:9px;min-height:82px;min-width:82px}.visual-stage p{margin-bottom:8px}.visual-stage .panel{margin:0;padding:14px}.visual-stage .numberline{gap:9px;margin:14px 0}.visual-stage .tile{font-size:27px;min-width:55px;padding:10px}.compare-groups{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.compare-groups .card{padding:10px;border-radius:16px;box-shadow:none}.compare-groups .stat{font-size:29px}.compare-groups .object{min-width:36px}.compare-groups .objects{font-size:24px;line-height:1.8;padding:4px;word-break:normal}.compare-groups h3{font-size:16px}.build-goal{font-size:18px;color:#6e5d30;margin:0 0 8px}.puzzle-result{height:105px}.puzzle-result svg{height:105px;width:180px}.answer-dock{position:sticky;bottom:12px;z-index:3;margin-top:15px;padding:14px 6px 5px;background:rgba(255,255,255,.98);border-top:1px solid #e4ebdf;border-radius:0 0 16px 16px}.answer-caption{display:block;color:#63805d;font-size:13px;font-weight:700;margin-bottom:10px}.answer-dock .choices{gap:12px;margin:0;align-items:center}.answer-dock .choice{border:2px solid #b8d2b0;border-radius:19px;min-width:82px;min-height:72px;font-size:29px;background:#f9fcf5;box-shadow:0 3px 0 #e0e9da;padding:10px 16px}.answer-dock .choice:hover{border-color:#4a8056;background:#edf6e3}.answer-dock>.primary{min-height:56px;padding:12px 28px}.answer-dock .next-answer{width:100%;font-size:19px}.play-card .feedback{font-size:16px;padding:12px 16px;margin:12px 0 0;text-align:left;line-height:1.5}.play-sidebar{position:sticky;top:18px;display:grid;gap:14px}.companion-card{text-align:center;border:1px solid #dce5ce;background:#eaf1de;border-radius:24px;padding:18px 12px 12px}.companion-card .rabbit.mini{width:106px;height:118px}.companion-card p{font-size:15px;line-height:1.5;margin:3px 0 0;color:#476443}.side-tip{text-align:center;font-size:13px;color:#77856d;line-height:1.6}.play-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:16px}.play-bottom>span{font-size:12px;color:#7c8a75}.english-strip{border:1px solid #d6e6eb;background:#eff7fa;border-radius:18px;padding:12px 14px;text-align:left;margin:0;min-width:0}.english-strip-top{display:flex;justify-content:space-between;gap:12px;align-items:center}.english-label{color:#477382;font-size:12px;font-weight:800;letter-spacing:.1px}.english-toggle{display:flex;align-items:center;gap:5px;margin:0;font-size:12px;color:#477382;cursor:pointer;min-height:30px}.english-toggle input{width:18px;height:18px;min-height:18px;margin:0;accent-color:#477382}.english-now{margin:8px 0;line-height:1.3}.english-now b{display:block;color:#285e76;font-size:20px}.english-now>span{display:block;color:#6a8490;font-size:13px;margin-top:3px}.english-actions{display:flex;gap:6px;align-items:center}.english-actions button{font-size:12px;padding:8px 10px;min-height:40px;border-radius:11px}.english-listen{background:white;border:1px solid #cee0e7;color:#2e647c}.english-strip>small{font-size:12px}.vocabulary-list{display:grid;gap:10px;margin:18px 0}.vocabulary-row{display:flex;align-items:center;justify-content:space-between;gap:14px;background:#eef7fa;border-radius:18px;padding:16px}.vocabulary-row b{display:block;font-size:25px;color:#285e76}.vocabulary-row span{display:block;color:#66818b;font-size:16px}.intro-screen{max-width:820px}.intro-heading{text-align:left;margin-bottom:18px}.intro-heading h2{margin:12px 0 0;font-size:30px}.intro-text{display:flex;align-items:center;gap:22px;text-align:left}.intro-text p{font-size:20px;line-height:1.6;margin:0}.intro-text .rabbit.mini{width:85px;height:98px}.example-zone{background:#f5f8ef;border-radius:18px;padding:15px;margin-top:18px}.example-zone p{font-size:14px;margin-bottom:6px}.example-zone .objects{padding:8px}.example-zone .shape{width:62px;height:62px}.intro-action{margin-top:22px}.intro-action .primary{min-width:240px}.intro-screen>.english-strip{display:grid;grid-template-columns:170px 1fr auto;align-items:center;gap:14px;margin-top:14px}.intro-screen>.english-strip .english-now{margin:0}.intro-screen>.english-strip .english-now b{display:inline;font-size:18px}.intro-screen>.english-strip .english-now span{display:inline;font-size:14px;margin-left:8px}.intro-screen>.english-strip .english-strip-top{gap:8px}.student-dashboard>.send-card{border:2px solid #287256;box-shadow:0 5px 16px #2872561a;margin:0 0 20px}.student-dashboard>.send-card form button{font-size:18px;min-height:58px}.send-card{display:flex;align-items:center;flex-wrap:wrap;justify-content:space-between;gap:14px;background:#eef4e8;border:1px solid #d9e4ce;border-radius:21px;padding:18px 22px;margin:22px 0;text-align:left}.send-summary{display:flex;align-items:center;gap:12px}.send-icon{font-size:27px;background:#fff;border-radius:14px;padding:6px 11px}.send-summary b{display:block;font-size:17px}.send-summary small{display:block;font-size:12px}.send-card form{margin:0}.send-card form button{min-height:48px;font-size:15px}.send-status{width:100%;font-size:12px;margin:0}.send-details{width:100%;font-size:12px;color:#75816f}.send-details summary{cursor:pointer}.send-details p{margin:7px 0}.student-dashboard .panel.soft.row{padding:16px 22px;border-radius:22px;gap:18px}.student-dashboard .panel.soft.row .rabbit.mini{width:67px;height:73px}.student-dashboard .panel.soft.row h3{margin:0 0 5px;font-size:20px}.student-dashboard .panel.soft.row p{margin:0}.student-dashboard>.row.between>div>p{margin-bottom:8px}.lesson-grid{grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:16px}.lesson-card{display:flex;flex-direction:column;padding:22px;border-radius:22px;box-shadow:none}.lesson-card .badge{align-self:flex-start;font-size:12px}.lesson-card h3{font-size:21px;line-height:1.35}.lesson-card p.muted{font-size:14px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:12px}.lesson-card>p:last-of-type{margin-top:auto;font-size:13px}.lesson-card>.primary{font-size:16px;width:100%;min-height:51px}.lesson-card:hover{border-color:#a7c3a2;box-shadow:0 8px 24px #385f3b0a}body[data-screen="game"] .top,body[data-screen="intro"] .top{padding-bottom:12px;margin-bottom:18px}body[data-screen="game"] footer,body[data-screen="intro"] footer{display:none}body[data-screen="game"] .wrap{padding-top:14px;padding-bottom:16px}
@media(max-width:820px){.play-layout{grid-template-columns:minmax(0,1fr)}.play-sidebar{position:static;display:block}.companion-card,.side-tip{display:none}.play-sidebar .english-strip{display:grid;grid-template-columns:145px minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 14px}.play-sidebar .english-now{margin:0}.play-sidebar .english-now b{font-size:18px}.play-sidebar .english-now span{font-size:12px}.play-sidebar .english-strip-top{gap:6px}.play-card{padding:20px}.visual-stage{max-height:290px}.answer-dock{bottom:8px}.play-bottom{margin-top:10px}.play-heading .badge{font-size:12px}.play-lesson{font-size:12px}.play-screen .progress{margin-bottom:12px}}
@media(max-width:520px){body{font-size:16px}.wrap{padding:14px}.play-card{padding:16px;border-radius:22px}.question-head{gap:9px;margin-bottom:8px}.question-head h2{font-size:23px}.question-mark{width:32px;height:32px;font-size:20px;border-radius:10px}.question-tools{margin:4px 0 10px;gap:7px}.question-tools button{padding:8px 10px;font-size:12px}.visual-stage{padding:10px 6px;border-radius:16px;max-height:270px;min-height:96px}.visual-stage .object{font-size:26px;min-width:43px;min-height:46px;padding:1px 6px}.visual-stage .choices{gap:7px}.visual-stage .shape{width:58px;height:58px}.visual-stage .choice{padding:6px;min-width:73px;min-height:73px}.visual-stage .numberline{gap:7px;margin:9px 0}.visual-stage .tile{min-width:44px;padding:7px;font-size:25px}.compare-groups{gap:8px}.compare-groups .card{padding:8px}.compare-groups .stat{font-size:26px}.compare-groups h3{font-size:14px}.compare-groups .objects{font-size:21px}.answer-dock{padding:10px 0 1px;margin-top:12px}.answer-dock .choices{gap:8px}.answer-dock .choice{min-width:60px;min-height:62px;font-size:26px;padding:9px 12px;border-radius:16px}.answer-dock .choice[style]{font-size:16px!important;flex:1;min-width:0;padding:9px 7px}.answer-caption{font-size:12px;margin-bottom:8px}.play-card .feedback{font-size:14px;padding:10px 12px}.play-sidebar .english-strip,.intro-screen>.english-strip{grid-template-columns:minmax(0,1fr) auto;gap:5px 10px;padding:10px 12px}.english-strip-top{grid-column:1/-1}.play-sidebar .english-now,.intro-screen>.english-strip .english-now{grid-column:1;margin:0}.play-sidebar .english-now b,.intro-screen>.english-strip .english-now b{font-size:17px;display:block}.play-sidebar .english-now span,.intro-screen>.english-strip .english-now span{display:block;font-size:12px;margin:2px 0 0}.english-actions{grid-column:2;grid-row:2;gap:5px}.english-actions button{min-height:40px;font-size:11px;padding:7px 8px}.english-strip-top{min-height:22px}.english-toggle{min-height:22px}.intro-heading h2{font-size:26px}.intro-text{gap:12px;align-items:flex-start}.intro-text .rabbit.mini{width:56px;height:67px}.intro-text p{font-size:17px}.intro-card .objects{gap:6px}.intro-card .object{min-width:45px;min-height:48px;font-size:26px}.intro-action{margin-top:16px}.intro-action .primary{width:100%;min-width:0}.play-bottom>span{display:none}.play-heading .badge{font-size:11px}.step-counter{font-size:23px;padding:5px 12px}.play-lesson{max-width:260px;font-size:11px;line-height:1.4}.send-card{padding:16px;gap:12px}.send-summary{gap:9px}.send-summary b{font-size:16px}.send-summary small{font-size:11px}.send-card form{width:100%}.send-card form button{width:100%}.lesson-grid{grid-template-columns:1fr;gap:12px}.lesson-card{padding:19px}.student-dashboard .panel.soft.row{padding:14px;gap:10px}.student-dashboard .panel.soft.row h3{font-size:18px}.student-dashboard .panel.soft.row .rabbit.mini{width:51px;height:57px}.top{margin-bottom:18px}.brand{font-size:18px}.brand span{font-size:9px;letter-spacing:1.3px}.top .row{gap:6px}.top button.small{padding:8px 10px;font-size:12px}.puzzle-result{height:94px}.puzzle-result svg{height:94px}}

.answer-dock[data-kind="compare"] .choices{flex-wrap:nowrap}.answer-dock[data-kind="compare"] .choice{flex:1;min-width:0;font-size:22px;padding:10px 12px}@media(max-width:520px){.answer-dock[data-kind="compare"] .choice{font-size:17px;padding:8px 7px;line-height:1.35;min-height:62px}}
</style></head><body><div id="app"></div><div id="toast" class="toast hidden" role="status"></div><dialog id="modal"></dialog>
<script>
'use strict';
const KEY='ban-nho-ai-v1';
const fresh=()=>({schema:1,teacher:null,classes:[],students:[],lessons:[],runs:[],settings:{name:'Thỏ Trắng',greeting:'Chào bạn! Mình là Thỏ Trắng. Chúng mình cùng chơi và ôn Toán nhé!',praise:'Bạn đã rất cố gắng. Mình cùng luyện tiếp nhé!',color:'#29775c',image:'',milestones:[5,10,20]}});
let db=fresh(),storageOK=true,page='home',teacher=false,student=null,tab='overview',draft=null,run=null,preview=false,english=true,selected=[],touches=new Set(),manip=0,feedback='',locked=false,filter={},loginFails=0,lockUntil=0,currentAudio=null,formTaskIndex=-1;
try{const raw=localStorage.getItem(KEY);if(raw){const p=JSON.parse(raw);if(p.schema!==1||!Array.isArray(p.runs)||!Array.isArray(p.lessons))throw Error('schema');db=p;}localStorage.setItem(KEY,JSON.stringify(db));}catch(e){storageOK=false;}
const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),norm=s=>String(s).normalize('NFC').trim().replace(/\s+/g,' ').toLocaleLowerCase('vi'),uid=()=>{try{if(globalThis.crypto&&typeof globalThis.crypto.randomUUID==='function')return globalThis.crypto.randomUUID();}catch(e){}return Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)+'-'+Math.random().toString(36).slice(2);},clone=x=>JSON.parse(JSON.stringify(x)),date=s=>s?new Date(s).toLocaleString('vi-VN'):'—';
const TYPES={count:'Giỏ cà rốt',sequence:'Đường về nhà',operation:'Thêm vào – Bớt đi',compare:'So sánh cùng Thỏ',shape:'Tìm hình cùng Thỏ',split:'Tách và gộp nhóm',puzzle:'Ghép hình khéo tay',choice:'Quan sát và chọn'};
const SHAPES={circle:'hình tròn',triangle:'hình tam giác',square:'hình vuông',rectangle:'hình chữ nhật',cube:'khối lập phương',cuboid:'khối hộp chữ nhật'};
function save(){try{localStorage.setItem(KEY,JSON.stringify(db));storageOK=true;return true;}catch(e){storageOK=false;toast('Chưa lưu bền vững được. Dữ liệu hiện chỉ ở trong phiên này; có thể do bộ nhớ đầy hoặc trình duyệt chặn lưu.');return false;}}
function toast(s){$('toast').textContent=s;$('toast').classList.remove('hidden');clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('toast').classList.add('hidden'),4800);}
function stopAudio(){if(currentAudio){currentAudio.pause();currentAudio=null;}if('speechSynthesis'in window)speechSynthesis.cancel();}
function voices(lang){return 'speechSynthesis'in window?speechSynthesis.getVoices().filter(v=>v.lang.toLowerCase().startsWith(lang)):[];}
function speak(text,lang='vi',voiceURI=''){stopAudio();if(!('speechSynthesis'in window)){toast('Thiết bị không hỗ trợ đọc. Bạn hãy đọc nội dung trên màn hình.');return false;}let vs=voices(lang),v=vs.find(x=>x.voiceURI===voiceURI)||vs[0];if(!v){toast('Chưa có giọng '+(lang==='vi'?'tiếng Việt':'tiếng Anh')+' phù hợp trên thiết bị này.');return false;}const u=new SpeechSynthesisUtterance(text);u.voice=v;u.lang=v.lang;u.rate=.85;u.onerror=()=>toast('Không phát được giọng đọc. Hãy kiểm tra kết nối hoặc dùng bản thu.');speechSynthesis.speak(u);return true;}
function rabbit(mini=false){if(db.settings.image)return `<img class="rabbit ${mini?'mini':''}" src="${db.settings.image}" alt="${esc(db.settings.name)}">`;return `<svg class="rabbit ${mini?'mini':''}" viewBox="0 0 260 290" role="img" aria-label="Thỏ Trắng"><ellipse cx="130" cy="273" rx="75" ry="9" fill="#cadaaa"/><ellipse cx="100" cy="63" rx="23" ry="60" transform="rotate(-12 100 63)" fill="white" stroke="#b6cfc0" stroke-width="3"/><ellipse cx="162" cy="63" rx="23" ry="60" transform="rotate(12 162 63)" fill="white" stroke="#b6cfc0" stroke-width="3"/><ellipse cx="100" cy="63" rx="10" ry="42" transform="rotate(-12 100 63)" fill="#f6d7d6"/><ellipse cx="162" cy="63" rx="10" ry="42" transform="rotate(12 162 63)" fill="#f6d7d6"/><ellipse cx="130" cy="221" rx="64" ry="53" fill="#96cdd4"/><ellipse cx="84" cy="263" rx="27" ry="15" fill="white"/><ellipse cx="176" cy="263" rx="27" ry="15" fill="white"/><ellipse cx="66" cy="213" rx="19" ry="32" transform="rotate(25 66 213)" fill="white"/><ellipse cx="195" cy="202" rx="18" ry="33" transform="rotate(-35 195 202)" fill="white"/><ellipse cx="130" cy="139" rx="80" ry="67" fill="white" stroke="#c1d5c4" stroke-width="3"/><ellipse cx="78" cy="153" rx="16" ry="10" fill="#f6d7d6"/><ellipse cx="181" cy="153" rx="16" ry="10" fill="#f6d7d6"/><ellipse cx="104" cy="132" rx="5" ry="7" fill="#29484a"/><ellipse cx="156" cy="132" rx="5" ry="7" fill="#29484a"/><path d="M123 146 Q130 138 137 146 L130 153Z" fill="#e89c9b"/><path d="M130 153 Q119 166 111 157 M130 153 Q141 166 149 157" fill="none" stroke="#29484a" stroke-width="3" stroke-linecap="round"/><path d="M118 225 Q131 216 142 225 L130 249Z" fill="#ec8e48"/><path d="M130 223 L124 211 M130 223 L138 212" stroke="#47885f" stroke-width="4" stroke-linecap="round"/></svg>`;}
const btn=(text,fn,cls='')=>`<button class="${cls}" onclick="${fn}">${text}</button>`;
function header(){return `<header class="top"><div class="brand">🥕 BẠN NHỎ AI<span>TOÁN 1 · HỌC MÀ CHƠI</span></div><div class="row">${page!=='home'?btn('⌂ Trang chủ','home()','small ghost'):''}${teacher?'<span class="badge">Giáo viên</span>'+btn('Đăng xuất','logout()','small ghost'):student?`<span class="badge">${esc(student.name)}</span>${btn('Đăng xuất','logout()','small ghost')}`:''}</div></header>`;}
let lastRenderedKey='';
function render(){const renderKey=page==='game'&&run?page+':'+run.id+':'+run.index:page,keepScroll=renderKey===lastRenderedKey,scrollPosition=window.scrollY||0;document.body.dataset.screen=page;stopAudio();document.documentElement.style.setProperty('--green',db.settings.color);let body='';if(page==='home')body=homeView();if(page==='studentLogin')body=studentLoginView();if(page==='teacherLogin')body=teacherLoginView();if(page==='teacher')body=teacherView();if(page==='student')body=studentView();if(page==='intro')body=introView();if(page==='game')body=gameView();if(page==='result')body=resultView();if(page==='garden')body=gardenView();$('app').innerHTML=`<div class="wrap">${header()}${!storageOK?'<div class="notice" role="alert">Trình duyệt chưa lưu được dữ liệu bền vững. Dữ liệu hiện chỉ ở trong phiên này; đừng đóng trang khi đang học.</div>':''}<main>${body}</main><footer>Toán là chính · Tiếng Anh vừa sức · Mỗi ngày một chút niềm vui<br><button class="small ghost" onclick="document.body.classList.toggle('reduce')">Giảm chuyển động</button> <button class="small ghost" onclick="stopAudio()">Dừng âm thanh</button></footer></div>`;lastRenderedKey=renderKey;window.scrollTo(0,keepScroll?scrollPosition:0);}
function home(){if(run&&!preview&&run.status==='active')save();run=null;preview=false;page=teacher?'teacher':student?'student':'home';render();}
function logout(){stopAudio();teacher=false;student=null;run=null;preview=false;draft=null;page='home';render();}
function homeView(){return `<section class="hero"><div><p class="eyebrow">Một khu vườn nhỏ, nhiều điều hay</p><h1>Cùng Thỏ Trắng<br>chơi vui, hiểu Toán.</h1><p class="muted">Đếm những củ cà rốt, tìm đường về nhà và khám phá các hình. Mỗi bài học là một niềm vui mới!</p><div class="row">${btn('Bắt đầu học →',"page='studentLogin';render()",'primary')}${btn('Khu vực giáo viên',"page='teacherLogin';render()",'ghost')}</div><p style="font-size:14px;margin-top:20px">Dành cho học sinh lớp 1 · 20 bài có sẵn · Có tiếng Anh · Giao diện gọn · Dễ chọn đáp án</p></div><div class="rabbit-stage">${rabbit()}<div class="bubble">${esc(db.settings.greeting)}</div></div></section><div class="grid"><div class="card"><span class="badge">01</span><h3 style="margin-top:16px">Cùng nhớ bài</h3><p class="muted">Ôn một ví dụ nhỏ, nhìn hình và thử thao tác.</p></div><div class="card"><span class="badge">02</span><h3 style="margin-top:16px">Chơi để luyện</h3><p class="muted">Những trò chơi ngắn, có gợi ý khi bạn cần.</p></div><div class="card"><span class="badge">03</span><h3 style="margin-top:16px">Nhìn lại kết quả</h3><p class="muted">Nhìn thấy sự cố gắng trong khu vườn của mình.</p></div></div>`;}
function studentLoginView(){return `<div class="narrow panel"><div style="text-align:center">${rabbit(true)}<h2>Chào bạn nhỏ!</h2><p class="muted">Điền họ tên hoặc lớp là có thể vào học nhé!</p></div><form onsubmit="studentLogin(event)"><label for="sn">Họ và tên học sinh</label><input id="sn" autocomplete="name" maxlength="100" placeholder="Ví dụ: Nguyễn Minh An"><label for="sclass">Lớp</label><input id="sclass" autocomplete="off" maxlength="60" placeholder="Ví dụ: 1A"><p id="loginError" class="error" role="alert"></p><button type="button" onclick="studentLogin(event)" class="primary" style="width:100%;margin-top:15px">Vào học cùng Thỏ →</button></form><small>20 bài SGK có sẵn để học ngay. Chỉ cần điền ít nhất một ô. Không cần mã hay hồ sơ có sẵn. Điền cả họ tên và lớp giúp theo dõi kết quả rõ hơn. Nếu chỉ nhập lớp, mỗi lần vào sẽ tạo một lượt hồ sơ mới.</small></div>`;}
function studentLogin(e){if(e)e.preventDefault();const errorBox=$('loginError');try{const clean=value=>String(value||'').normalize('NFC').trim().replace(/\s+/g,' '),name=clean($('sn')?.value),classText=clean($('sclass')?.value);if(!name&&!classText){errorBox.textContent='Bạn điền họ tên hoặc lớp để vào học nhé!';return;}errorBox.textContent='';let c=classText?db.classes.find(c=>norm(c.name)===norm(classText)):null;if(classText&&!c){c={id:uid(),name:classText};db.classes.push(c);}const classId=c?.id||'';let s=name?db.students.find(x=>x.active&&norm(x.name)===norm(name)&&x.classId===classId):null;if(!s){s={id:uid(),name:name||'Bạn nhỏ',classId,active:true,quickLogin:true};db.students.push(s);}student=s;teacher=false;loginFails=0;run=null;preview=false;filter.volume='';save();page='student';render();}catch(error){console.error('Không mở được trang học:',error);page='studentLogin';if($('loginError'))$('loginError').textContent='Chưa mở được trang học. Bạn hãy tải file HTML mới và mở bằng Chrome hoặc Edge. Dữ liệu đã có được giữ nguyên.';}}
function teacherLoginView(){return `<div class="narrow panel"><span class="badge">Góc của thầy cô</span><h2 style="margin-top:18px">${db.teacher?'Chào mừng trở lại':'Thiết lập lần đầu'}</h2><div class="notice">Bản HTML lưu dữ liệu trên thiết bị này, chưa đồng bộ giữa các thiết bị. Mã truy cập chỉ hạn chế thao tác nhầm, không thay thế bảo mật máy chủ.</div><form onsubmit="teacherLogin(event)"><label for="pin">${db.teacher?'Mã truy cập giáo viên':'Tạo mã truy cập giáo viên (ít nhất 6 ký tự)'}</label><input id="pin" type="password" required minlength="6" autocomplete="${db.teacher?'current-password':'new-password'}">${!db.teacher?'<label for="pin2">Nhập lại mã truy cập</label><input id="pin2" type="password" required minlength="6" autocomplete="new-password">':''}<p id="pinError" class="error" role="alert"></p><button class="primary" style="margin-top:18px;width:100%">${db.teacher?'Mở khu vực giáo viên':'Thiết lập và bắt đầu'}</button></form><small>Hãy ghi nhớ mã. Bản cục bộ không có chức năng khôi phục mã qua email.</small></div>`;}
async function digest(s){if(!crypto.subtle)throw Error('Trình duyệt không hỗ trợ thiết lập mã trên trang này. Hãy dùng Chrome/Edge mới và mở file trực tiếp.');return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s)))).map(x=>x.toString(16).padStart(2,'0')).join('');}
async function teacherLogin(e){e.preventDefault();if(Date.now()<lockUntil){$('pinError').textContent='Vui lòng chờ một phút rồi thử lại.';return;}try{const pin=$('pin').value;if(!db.teacher){if(pin!==$('pin2').value)throw Error('Hai lần nhập chưa khớp.');const salt=uid();db.teacher={salt,hash:await digest(salt+pin)};save();}else if(await digest(db.teacher.salt+pin)!==db.teacher.hash){loginFails++;if(loginFails>=5){lockUntil=Date.now()+60000;loginFails=0;}throw Error('Mã truy cập chưa đúng.');}teacher=true;student=null;page='teacher';tab='overview';render();}catch(e){$('pinError').textContent=e.message;}}
function teacherView(){if(!teacher){page='teacherLogin';return teacherLoginView();}const tabs={overview:'Tổng quan',students:'Lớp & học sinh',lessons:'Bài học',results:'Kết quả',settings:'Cài đặt'};return `<div class="nav">${Object.entries(tabs).map(([k,v])=>btn(v,`switchTab('${k}')`,tab===k?'active':'')).join('')}</div>${tab==='overview'?overviewView():tab==='students'?studentsView():tab==='lessons'?lessonsView():tab==='editor'?editorView():tab==='results'?resultsView():settingsView()}`;}
function switchTab(t){if(tab==='editor'&&draft&&!confirm('Rời trình soạn? Thay đổi chưa bấm Lưu nháp sẽ không được giữ.'))return;tab=t;draft=null;render();}
function overviewView(){return `<div class="notice">Dữ liệu đang lưu trên thiết bị này. Chưa đồng bộ hồ sơ giữa các thiết bị hoặc kết nối Gemini API. Nút Gửi kết quả gửi bản tổng hợp tới Google Sheets. Giọng đọc có thể cần kết nối mạng tùy thiết bị.</div><h2>Xin chào thầy cô 🌿</h2><p class="muted">Chuẩn bị một bài học nhỏ, mở ra một hành trình vui.</p><div class="grid">${[[db.classes.length,'Lớp học'],[db.students.filter(x=>x.active).length,'Học sinh hoạt động'],[db.lessons.filter(x=>x.published&&!x.hidden).length,'Bài đang xuất bản'],[db.runs.filter(x=>x.status==='complete').length,'Lượt hoàn thành']].map(([n,t])=>`<div class="card"><div class="stat">${n}</div>${t}</div>`).join('')}</div><div class="panel" style="margin-top:24px"><h3>Bắt đầu với 3 bước</h3><ol class="note-list"><li>Vào <b>Lớp & học sinh</b>: tạo lớp nếu cần. Học sinh có thể tự vào học mà không cần tạo hồ sơ trước.</li><li>Vào <b>Bài học</b>: nhập đúng thông tin SGK, tạo ví dụ và ít nhất một nhiệm vụ; xem trước rồi xuất bản.</li><li>Đăng xuất khu vực giáo viên; học sinh chỉ cần nhập họ tên hoặc lớp trên cùng trình duyệt; không cần mã hay đối chiếu hồ sơ.</li></ol><p class="muted">Không có dữ liệu mẫu. Kết quả chỉ phát sinh từ những lượt học thực tế.</p>${btn('Tạo lớp và học sinh',"switchTab('students')",'primary')}</div><div class="panel blue"><h3>Đã có học liệu theo SGK cô cung cấp</h3><p>20 bài của Toán 1 – Kết nối tri thức với cuộc sống, tập một. Số bài, tên bài và trang được đối chiếu mục lục. Các trò chơi được biên soạn mới theo mục tiêu bài, không phải bản sao bài tập trong sách.</p><p>Học sinh có thể mở sẵn 20 bài ngay sau khi nhập họ tên hoặc lớp. Vào Bài học nếu cô muốn chỉnh nội dung và xuất bản phiên bản riêng cho lớp.</p>${btn('Mở học liệu SGK',"switchTab('lessons')",'primary')}</div>`;}
function classOptions(value='',all=false){return `${all?'<option value="">Tất cả lớp</option>':'<option value="">Chọn lớp</option>'}${db.classes.map(c=>`<option value="${c.id}" ${value===c.id?'selected':''}>${esc(c.name)}</option>`).join('')}`;}
function className(id){return id?(db.classes.find(c=>c.id===id)?.name||'Lớp đã ngừng'):'Chưa nhập lớp';}
function studentsView(){return `<h2>Lớp học & bạn nhỏ</h2><div class="cols"><section><div class="panel"><h3>Thêm hồ sơ học sinh</h3><form onsubmit="addStudent(event)"><label>Lớp<select id="stClass" required>${classOptions()}</select></label><label>Họ và tên<input id="stName" required maxlength="100"></label><small>Có thể thêm trước hồ sơ, hoặc để học sinh tự nhập thông tin khi vào học.</small><button class="primary" style="margin-top:16px">Thêm học sinh</button></form></div><div class="panel"><h3>Thêm nhiều học sinh</h3><p class="muted">Mỗi dòng một họ và tên. Không cần nhập mã học sinh.</p><label>Lớp<select id="bulkClass">${classOptions()}</select></label><textarea id="bulkStudents" placeholder="Mỗi dòng một họ và tên" aria-label="Danh sách học sinh"></textarea>${btn('Thêm danh sách','bulkStudents()','ghost')}</div></section><section><div class="panel soft"><h3>Tạo lớp</h3><form onsubmit="addClass(event)"><label>Tên lớp<input id="className" required maxlength="60" placeholder="Ví dụ: 1A"></label><button class="primary" style="margin-top:14px">Tạo lớp</button></form><div style="margin-top:18px">${db.classes.map(c=>`<span class="chip">${esc(c.name)}</span>`).join(' ')||'<small>Chưa có lớp.</small>'}</div></div><div class="notice">Hồ sơ và kết quả được nối bằng ID riêng. Hai học sinh trùng tên vẫn có tiến độ riêng.</div></section></div><div class="panel"><h3>Danh sách học sinh (${db.students.length})</h3>${db.students.length?`<div class="table-wrap"><table><thead><tr><th>Họ và tên</th><th>Lớp</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>${db.students.map(s=>`<tr><td>${esc(s.name)}</td><td>${esc(className(s.classId))}</td><td>${s.active?'Đang hoạt động':'Tạm ngừng'}</td><td>${btn('Sửa hồ sơ',`editStudent('${s.id}')`,'small ghost')} ${btn(s.active?'Tạm ngừng':'Kích hoạt',`toggleStudent('${s.id}')`,'small ghost')}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Chưa có học sinh. Thêm hồ sơ đầu tiên ở phía trên.</div>'}</div>`;}
function addClass(e){e.preventDefault();const name=$('className').value.trim();if(!name)return;if(db.classes.some(c=>norm(c.name)===norm(name)))return toast('Tên lớp đã có.');db.classes.push({id:uid(),name});save();render();toast('Đã tạo lớp trong phiên hiện tại.');}
function validStudent(name){if(!name.trim())throw Error('Nhập họ tên học sinh.');}
function addStudent(e){e.preventDefault();try{const name=$('stName').value.trim(),classId=$('stClass').value;validStudent(name);if(!classId)throw Error('Hãy chọn lớp.');if(db.students.some(s=>s.active&&s.classId===classId&&norm(s.name)===norm(name)))throw Error('Lớp đã có hồ sơ tên này.');db.students.push({id:uid(),name,classId,active:true});save();render();toast('Đã thêm hồ sơ.');}catch(e){toast(e.message);}}
function bulkStudents(){try{const classId=$('bulkClass').value;if(!classId)throw Error('Hãy chọn lớp.');const names=$('bulkStudents').value.trim().split(/\n/).map(x=>x.trim()).filter(Boolean);if(!names.length)throw Error('Danh sách đang trống.');const seen=new Set(db.students.filter(s=>s.active&&s.classId===classId).map(s=>norm(s.name)));let n=0;for(const name of names){validStudent(name);if(seen.has(norm(name)))continue;seen.add(norm(name));db.students.push({id:uid(),name,classId,active:true});n++;}save();render();toast('Đã thêm '+n+' hồ sơ; bỏ qua tên đã có trong lớp.');}catch(e){toast(e.message);}}
function toggleStudent(id){const s=db.students.find(x=>x.id===id);if(!confirm((s.active?'Tạm ngừng':'Kích hoạt')+' hồ sơ '+s.name+'?'))return;s.active=!s.active;save();render();}
function editStudent(id){const s=db.students.find(x=>x.id===id);$('modal').innerHTML=`<h2>Sửa hồ sơ</h2><form onsubmit="updateStudent(event,'${id}')"><label>Họ tên<input id="esn" value="${esc(s.name)}" required></label><label>Lớp<select id="escl">${classOptions(s.classId)}</select></label><div class="row" style="margin-top:20px"><button class="primary">Lưu hồ sơ</button><button type="button" class="ghost" onclick="$('modal').close()">Hủy</button></div></form>`;$('modal').showModal();}
function updateStudent(e,id){e.preventDefault();try{const s=db.students.find(x=>x.id===id),name=$('esn').value.trim(),classId=$('escl').value;validStudent(name);Object.assign(s,{name,classId});save();$('modal').close();render();}catch(e){toast(e.message);}}
function lessonsView(){return `<div class="row between"><div><h2>Thư viện bài học</h2><p class="muted">Đúng tập, đúng bài, đúng phạm vi đã học.</p></div>${btn('+ Tạo bài học',"editLesson()",'primary')}</div><div class="panel blue"><h3>📘 Học liệu từ SGK đã cung cấp · 20 bài</h3><p>Nhập bộ bài vào một lớp dưới dạng bản nháp. Cô xem trước và duyệt từng bài trước khi học sinh sử dụng.</p><div class="row"><select id="bankClass" style="max-width:300px">${classOptions()}</select>${btn('Thêm 20 bài SGK vào lớp','installBook()','primary')}</div><small>Cùng một lớp không bị thêm trùng. Không kèm học sinh hay kết quả giả.</small></div>${db.lessons.length?`<div class="grid">${db.lessons.map(l=>`<article class="card"><span class="badge">${l.published&&!l.hidden?'Đã xuất bản · v'+l.published.version:l.hidden?'Đang ẩn':'Bản nháp'}${l.published&&l.draft?' · Có nháp mới':''}</span><p class="muted" style="margin-top:16px">${esc((l.draft||l.published).volume)} · Bài ${esc((l.draft||l.published).number)}</p><h3>${esc((l.draft||l.published).title||'Chưa đặt tên')}</h3><p>${esc(className((l.draft||l.published).classId))}</p><div class="row">${btn('Chỉnh sửa',`editLesson('${l.id}')`,'small primary')}${l.published?btn(l.hidden?'Hiện lại':'Ẩn bài',`toggleLesson('${l.id}')`,'small ghost'):''}</div></article>`).join('')}</div>`:'<div class="panel empty">Chưa có bài học. Hãy tạo bài từ học liệu SGK cô đang sử dụng.</div>'}`;}
function editLesson(id){const l=db.lessons.find(x=>x.id===id);draft=l?clone(l.draft||l.published):{id:uid(),book:'Toán 1 – Kết nối tri thức với cuộc sống',edition:'',volume:'Tập 1',number:'',title:'',pages:'',order:1,classId:db.classes[0]?.id||'',max:10,min:0,goal:'',intro:'',example:[],recap:'',outside:'',english:[],englishApproved:false,tasks:[],version:0};tab='editor';render();}
function field(label,id,value,type='text'){return `<label for="${id}">${label}</label><input id="${id}" type="${type}" value="${esc(value)}" ${type==='number'?'step="1"':''}>`;}
function editorView(){if(!draft)return lessonsView();return `<div class="row between"><h2>Soạn bài học</h2><span class="badge">${draft.version?'Từ phiên bản '+draft.version:'Bài mới'}</span></div><p class="muted">Nội dung được giáo viên nhập và duyệt. Chưa kết nối AI hoặc OCR tự động.</p><form id="lessonForm" onsubmit="saveDraft(event)"><div class="cols"><section><div class="panel"><h3>Thông tin đúng SGK</h3>${field('Bộ sách','lb',draft.book)}<div class="inlineform"><div>${field('Phiên bản sách','le',draft.edition)}</div><div>${field('Tập sách','lv',draft.volume)}</div><div>${field('Số / ký hiệu bài','ln',draft.number)}</div></div>${field('Tên bài','lt',draft.title)}<div class="inlineform"><div>${field('Trang tham chiếu','lp',draft.pages)}</div><div>${field('Thứ tự hiển thị','lo',draft.order,'number')}</div></div><label>Lớp sử dụng<select id="lc">${classOptions(draft.classId)}</select></label><div class="inlineform"><div>${field('Số nhỏ nhất','lmin',draft.min,'number')}</div><div>${field('Số lớn nhất (tối đa 100)','lmax',draft.max,'number')}</div></div><label>Mục tiêu ôn tập<textarea id="lg">${esc(draft.goal)}</textarea></label></div><div class="panel"><h3>Cùng nhớ bài</h3><label>Giải thích / ví dụ ngắn<textarea id="li" placeholder="Nhập ví dụ đúng kiến thức đã học">${esc(draft.intro)}</textarea></label><label>Thêm hình trực quan để chạm đếm</label><div class="row"><select id="exType" style="width:auto"><option value="carrot">Cà rốt</option><option value="circle">Hình tròn</option><option value="triangle">Tam giác</option><option value="square">Hình vuông</option><option value="rectangle">Chữ nhật</option></select><input id="exN" type="number" min="1" max="30" value="1" style="width:90px" aria-label="Số hình"><button type="button" class="small ghost" onclick="addExample()">Thêm hình</button><button type="button" class="small ghost" onclick="captureLesson();draft.example=[];render()">Xóa hình</button></div><div class="objects">${(draft.example||[]).map(x=>x==='carrot'?'🥕':shapeSVG(x)).join('')}</div><label>Nhìn lại: điều cần nhớ<textarea id="lr">${esc(draft.recap)}</textarea></label><label>Hoạt động ngoài màn hình<textarea id="lx">${esc(draft.outside)}</textarea></label></div></section><section><div class="panel blue"><h3>Tiếng Anh vừa sức</h3><p>Nhập 1–3 cụm, mỗi dòng: tiếng Anh | nghĩa tiếng Việt.</p><textarea id="len" placeholder="Let’s count! | Cùng đếm nào!">${esc((draft.english||[]).map(x=>x.en+' | '+x.vi).join('\n'))}</textarea><button type="button" class="ghost small" style="margin-top:10px" onclick="captureLesson();if(draft.english.length)speak(draft.english[0].en,'en')">Nghe thử cụm đầu</button><label class="check"><input type="checkbox" id="lea" ${draft.englishApproved?'checked':''}>Tôi đã kiểm tra nội dung và giọng tiếng Anh trên thiết bị này</label><small>Giọng đọc tùy thiết bị; các cụm chỉ được bật sau khi giáo viên duyệt.</small></div><div class="panel"><h3>Nguồn tham chiếu</h3><p class="muted">Mở ảnh hoặc PDF để đối chiếu. Tệp chỉ dùng trong phiên soạn, không trích xuất tự động và không lưu vào bài.</p><input type="file" accept="image/png,image/jpeg,image/webp,application/pdf" onchange="showReference(this)" aria-label="Mở tài liệu tham chiếu"><div id="reference"></div></div></section></div><div class="panel"><div class="row between"><div><h3>Chơi để luyện · ${draft.tasks.length} nhiệm vụ</h3><p class="muted">Chọn game đúng bài. Gợi ý: 2 game, mỗi game 3–5 nhiệm vụ.</p></div><button type="button" class="primary" onclick="captureLesson();taskDialog()">+ Thêm nhiệm vụ</button></div>${draft.tasks.map((t,i)=>`<div class="taskcard"><div class="row between"><div><span class="badge">${esc(TYPES[t.type])}</span><h3 style="margin-top:12px">${i+1}. ${esc(t.prompt)}</h3><small>${t.audioApproved?'🔊 Đã duyệt âm thanh':'Chưa có âm thanh được duyệt'} · ${t.audioRequired?'Bắt buộc nghe':'Có thể đọc hướng dẫn'}</small></div><div class="row"><button type="button" class="small ghost" onclick="captureLesson();taskDialog(${i})">Sửa</button><button type="button" class="small danger" onclick="removeTask(${i})">Xóa</button></div></div></div>`).join('')||'<div class="empty">Chưa có nhiệm vụ. Thêm nhiệm vụ đầu tiên để tạo trò chơi.</div>'}</div><div class="row"><button class="ghost">Lưu nháp</button><button type="button" class="ghost" onclick="previewDraft()">Xem trước như học sinh</button><button type="button" class="primary" onclick="publishDraft()">Duyệt & xuất bản →</button></div></form>`;}
function captureLesson(){if(!$('lessonForm'))return;let old=JSON.stringify(draft.english||[]);Object.assign(draft,{book:$('lb').value.trim(),edition:$('le').value.trim(),volume:$('lv').value.trim(),number:$('ln').value.trim(),title:$('lt').value.trim(),pages:$('lp').value.trim(),order:Number($('lo').value),classId:$('lc').value,min:Number($('lmin').value),max:Number($('lmax').value),goal:$('lg').value.trim(),intro:$('li').value.trim(),recap:$('lr').value.trim(),outside:$('lx').value.trim(),english:$('len').value.trim().split('\n').filter(x=>x.trim()).map(x=>{const p=x.split('|');return {en:p[0].trim(),vi:(p[1]||'').trim()};}),englishApproved:$('lea').checked});if(JSON.stringify(draft.english)!==old)draft.englishApproved=false;}
function addExample(){captureLesson();const n=Number($('exN').value);if(!Number.isInteger(n)||n<1||n>30||(draft.example||[]).length+n>30)return toast('Tối đa 30 hình cho ví dụ.');draft.example=(draft.example||[]).concat(Array(n).fill($('exType').value));render();}
function persistDraft(){let l=db.lessons.find(x=>x.id===draft.id);if(!l){l={id:draft.id,history:[],published:null,hidden:false};db.lessons.push(l);}l.draft=clone(draft);return save();}
function saveDraft(e){e.preventDefault();captureLesson();if(persistDraft())toast('Đã lưu bản nháp trên thiết bị.');}
function validateLesson(l,strict=true){if(!l.book||!l.volume||!l.number||!l.title||!l.classId||!l.pages||!l.goal||!l.intro||!l.recap)throw Error('Điền đủ bộ sách, tập, số bài, tên bài, trang, lớp, mục tiêu, ví dụ và điều cần nhớ.');if(!Number.isInteger(l.order)||!Number.isInteger(l.min)||!Number.isInteger(l.max)||l.min<0||l.max>100||l.max<l.min)throw Error('Phạm vi số phải là số nguyên từ 0 đến 100; kiểm tra thứ tự hiển thị.');if(!l.tasks.length)throw Error('Thêm ít nhất một nhiệm vụ.');if(l.english.length>3||l.english.some(x=>!x.en||!x.vi))throw Error('Tiếng Anh: tối đa 3 cụm, mỗi cụm đủ tiếng Anh | nghĩa tiếng Việt.');if(strict&&l.english.length&&!l.englishApproved)throw Error('Hãy duyệt tiếng Anh. Nếu vừa đổi nội dung, lưu nháp và duyệt lại.');l.tasks.forEach(t=>validateTask(t,l));}
function validateTask(t,l){if(!t.prompt.trim())throw Error('Nhiệm vụ cần có lời hướng dẫn.');const check=n=>{if(!Number.isInteger(n)||n<l.min||n>l.max)throw Error('Có số nằm ngoài phạm vi bài: '+n);};if(['count','operation','compare','split'].includes(t.type))check(t.a);if(['operation','compare','split'].includes(t.type))check(t.b);if(t.type==='split'){check(t.a+t.b);if(!['total','part'].includes(t.find))throw Error('Chọn cách tìm cả nhóm hoặc phần còn thiếu.');}if(t.type==='choice'){if(!Array.isArray(t.options)||t.options.length<2||t.options.length>6||!Number.isInteger(t.correct)||t.correct<0||t.correct>=t.options.length||new Set(t.options).size!==t.options.length)throw Error('Câu quan sát cần 2–6 lựa chọn khác nhau và chỉ số đáp án hợp lệ.');}if(t.type==='puzzle'&&(!['square','rectangle'].includes(t.target)||t.pieces!==2))throw Error('Bài ghép dùng hai mảnh để tạo hình vuông hoặc chữ nhật.');if(t.type==='operation'){if(!['+','-'].includes(t.op))throw Error('Phép tính chưa hợp lệ.');check(t.op==='+'?t.a+t.b:t.a-t.b);}if(t.type==='sequence'){if(t.seq.length<3||t.seq.length>9||!Number.isInteger(t.missing)||t.missing<0||t.missing>=t.seq.length)throw Error('Dãy cần 3–9 số và vị trí khuyết hợp lệ.');t.seq.forEach(check);const d=t.seq[1]-t.seq[0];if(!d||!t.seq.every((n,i)=>i===0||n-t.seq[i-1]===d))throw Error('Dãy phải có bước tăng hoặc giảm đều, khác 0.');}if(t.type==='shape'){if(!SHAPES[t.target]||t.shapes.length<2||t.shapes.length>6||t.shapes.some(s=>!SHAPES[s])||!t.shapes.includes(t.target))throw Error('Chọn từ 2–6 hình, có ít nhất một hình đúng.');}if(t.audioRequired&&!t.audioApproved)throw Error('Nhiệm vụ bắt buộc nghe chưa được duyệt âm thanh.');}
function publishDraft(){try{captureLesson();validateLesson(draft);if(!confirm('Tôi đã kiểm tra kiến thức, đáp án, phạm vi số, hình và âm thanh. Xuất bản bài cho lớp đã chọn?'))return;let l=db.lessons.find(x=>x.id===draft.id);if(!l){l={id:draft.id,history:[],published:null,hidden:false};db.lessons.push(l);}if(l.published)l.history.push(clone(l.published));draft.version=(l.published?.version||0)+1;l.published=clone(draft);l.published.publishedAt=new Date().toISOString();l.draft=null;l.hidden=false;save();tab='lessons';draft=null;render();toast('Bài đã được xuất bản trong dữ liệu trên thiết bị.');}catch(e){toast(e.message);}}
function toggleLesson(id){const l=db.lessons.find(x=>x.id===id);l.hidden=!l.hidden;save();render();}
function removeTask(i){captureLesson();if(confirm('Xóa nhiệm vụ này khỏi bản đang soạn?')){draft.tasks.splice(i,1);render();}}
let refURL='';function showReference(input){const f=input.files[0];if(!f)return;if(f.size>10*1024*1024||!['application/pdf','image/png','image/jpeg','image/webp'].includes(f.type))return toast('Chỉ nhận PDF, PNG, JPG, WebP tối đa 10 MB.');if(refURL)URL.revokeObjectURL(refURL);refURL=URL.createObjectURL(f);$('reference').innerHTML=f.type==='application/pdf'?`<a href="${refURL}" target="_blank" rel="noopener">Mở PDF tham chiếu ↗</a>`:`<img src="${refURL}" style="max-width:100%;margin-top:15px" alt="Ảnh nguồn giáo viên">`;}
function shapeSVG(s){const shapes={circle:'<circle cx="50" cy="50" r="34"/>',triangle:'<path d="M50 12 L90 84 H10Z"/>',square:'<rect x="17" y="17" width="66" height="66"/>',rectangle:'<rect x="7" y="29" width="86" height="42"/>',cube:'<path d="M15 30 L65 30 L85 12 L35 12Z" fill="#b7e0d0"/><path d="M65 30 L85 12 L85 62 L65 80Z" fill="#438788"/><path d="M15 30 H65 V80 H15Z"/>',cuboid:'<path d="M7 40 L72 40 L92 22 L27 22Z" fill="#b7e0d0"/><path d="M72 40 L92 22 L92 57 L72 75Z" fill="#438788"/><path d="M7 40 H72 V75 H7Z"/>'};return `<svg class="shape" viewBox="0 0 100 100" role="img" aria-label="${esc(SHAPES[s])}" fill="#79bac2" stroke="#2b6670" stroke-width="3">${shapes[s]||''}</svg>`;}
let taskAudio='',taskApproved=false,taskTested=false,taskVoice='';
function taskDialog(i=-1){formTaskIndex=i;const t=i>=0?draft.tasks[i]:{type:'count',mode:'choose',prompt:'',a:1,b:1,op:'+',seq:[1,2,3],missing:1,target:'circle',shapes:['circle','triangle','square'],hint:'',audio:'',audioApproved:false,audioRequired:false};taskAudio=t.audio||'';taskApproved=t.audioApproved||false;taskTested=false;taskVoice=t.voice||'';$('modal').innerHTML=`<h2>${i<0?'Thêm':'Sửa'} nhiệm vụ</h2><form onsubmit="commitTask(event)"><label>Mẫu game<select id="tt" onchange="taskApproved=false;taskFields()">${Object.entries(TYPES).map(([k,v])=>`<option value="${k}" ${t.type===k?'selected':''}>${v}</option>`).join('')}</select></label><label>Lời hướng dẫn<input id="tp" value="${esc(t.prompt)}" required oninput="taskApproved=false;taskTested=false"></label><div id="taskFields"></div><label>Gợi ý riêng (không bắt buộc)<textarea id="th">${esc(t.hint)}</textarea></label><hr class="hr"><h3>Âm thanh yêu cầu</h3><small>Chọn bản thu hoặc giọng thiết bị. Nghe và duyệt đúng nội dung trước khi lưu.</small><label>Tải bản thu (MP3/WAV/OGG, tối đa 1 MB)<input type="file" accept="audio/mpeg,audio/wav,audio/ogg" onchange="loadTaskAudio(this)"></label><div class="row"><button type="button" class="small ghost" onclick="taskTest()">Nghe thử hướng dẫn</button><button type="button" class="small ghost" onclick="approveTaskAudio()">Duyệt âm thanh</button><button type="button" class="small ghost" onclick="taskAudio='';taskApproved=false;$('tas').textContent='Dùng giọng thiết bị, chưa duyệt'">Bỏ bản thu</button></div><p id="tas" class="muted">${taskAudio?'Đã có bản thu. ':''}${taskApproved?'Đã duyệt.':'Chưa duyệt.'}</p><label class="check"><input id="tar" type="checkbox" ${t.audioRequired?'checked':''}>Bắt buộc có âm thanh để làm nhiệm vụ này</label><div class="row" style="margin-top:20px"><button class="primary">Lưu nhiệm vụ</button><button type="button" class="ghost" onclick="$('modal').close();stopAudio()">Hủy</button></div></form>`;$('modal').showModal();taskFields(t);}
function taskFields(t={}){const type=$('tt').value;let h='';if(['split','puzzle','choice'].includes(type))h='<div class="notice">Nhiệm vụ chuyên biệt từ bộ SGK. Chỉnh các trường dữ liệu JSON bên dưới; số thứ tự lựa chọn bắt đầu từ 0.</div><label>Dữ liệu nhiệm vụ<textarea id="specialTask" style="min-height:180px">'+esc(JSON.stringify(type===t.type?t:(type==='split'?{a:2,b:3,find:'total'}:type==='puzzle'?{target:'square',pieces:2}:{scene:'🔴 🟡 🟢',options:['Đỏ','Vàng','Xanh'],correct:1}),null,2))+'</textarea></label>';if(type==='count')h=`<label>Cách chơi<select id="tm"><option value="choose" ${t.mode!=='build'?'selected':''}>Chạm đếm và chọn số</option><option value="build" ${t.mode==='build'?'selected':''}>Thêm đủ cà rốt vào giỏ</option></select></label>${field('Số lượng đúng','ta',t.a??1,'number')}`;if(type==='operation')h=`<div class="inlineform"><div>${field('Số ban đầu','ta',t.a??1,'number')}</div><div><label>Phép tính<select id="top"><option value="+">Cộng (+)</option><option value="-" ${t.op==='-'?'selected':''}>Trừ (−)</option></select></label></div><div>${field('Số thêm / bớt','tb',t.b??1,'number')}</div></div>`;if(type==='compare')h=`<div class="inlineform"><div>${field('Số bên trái','ta',t.a??1,'number')}</div><div>${field('Số bên phải','tb',t.b??1,'number')}</div></div><label>Cách trả lời<select id="tcm"><option value="words">Nhiều hơn / ít hơn / bằng nhau</option><option value="symbols" ${t.compareMode==='symbols'?'selected':''}>Dấu &gt;, &lt;, = (đã học)</option></select></label>`;if(type==='sequence')h=`${field('Dãy số (ngăn bằng dấu phẩy)','tseq',(t.seq||[1,2,3]).join(', '))}${field('Vị trí cần điền, tính từ 1','tmiss',(t.missing??1)+1,'number')}<small>Giáo viên xác nhận dãy tăng/giảm đều và đúng kiến thức bài.</small>`;if(type==='shape')h=`<label>Hình cần tìm<select id="tshape">${Object.entries(SHAPES).map(([k,v])=>`<option value="${k}" ${t.target===k?'selected':''}>${v}</option>`).join('')}</select></label><label>Các hình xuất hiện (chọn 2–6 hình)<div id="shapeSlots">${Array.from({length:6},(_,i)=>`<select id="shape${i}" style="margin-bottom:7px"><option value="">Không dùng</option>${Object.entries(SHAPES).map(([k,v])=>`<option value="${k}" ${(t.shapes||['circle','triangle','square'])[i]===k?'selected':''}>${v}</option>`).join('')}</select>`).join('')}</div></label><small>Nếu lặp hình đúng, học sinh phải chọn đủ các hình đúng.</small>`;$('taskFields').innerHTML=h;}
function loadTaskAudio(input){const f=input.files[0];if(!f)return;if(f.size>1024*1024||!['audio/mpeg','audio/wav','audio/x-wav','audio/ogg'].includes(f.type))return toast('Chỉ nhận MP3, WAV hoặc OGG tối đa 1 MB.');const r=new FileReader();r.onload=()=>{taskAudio=r.result;taskApproved=false;taskTested=false;$('tas').textContent='Đã tải bản thu. Hãy nghe thử và duyệt.';};r.readAsDataURL(f);}
function taskTest(){if(!$('tp').value.trim())return toast('Nhập lời hướng dẫn trước.');stopAudio();if(taskAudio){currentAudio=new Audio(taskAudio);currentAudio.play().then(()=>{taskTested=true;}).catch(()=>toast('Bản thu không phát được.'));}else{taskVoice=voices('vi')[0]?.voiceURI||'';taskTested=speak($('tp').value,'vi',taskVoice);}taskApproved=false;}
function approveTaskAudio(){if(!taskTested)return toast('Hãy bấm Nghe thử hướng dẫn trước.');taskApproved=true;$('tas').textContent='Giáo viên đã duyệt âm thanh cho lời hướng dẫn này.';}
function commitTask(e){e.preventDefault();try{const type=$('tt').value;let t={id:formTaskIndex>=0?draft.tasks[formTaskIndex].id:uid(),type,prompt:$('tp').value.trim(),hint:$('th').value.trim(),audio:taskAudio,audioApproved:taskApproved,audioRequired:$('tar').checked,voice:taskVoice};if(['split','puzzle','choice'].includes(type)){const extra=JSON.parse($('specialTask').value);for(const k of type==='split'?['a','b','find']:type==='puzzle'?['target','pieces']:['scene','options','correct'])t[k]=extra[k];}if(type==='count')Object.assign(t,{a:Number($('ta').value),mode:$('tm').value});if(type==='operation')Object.assign(t,{a:Number($('ta').value),b:Number($('tb').value),op:$('top').value});if(type==='compare')Object.assign(t,{a:Number($('ta').value),b:Number($('tb').value),compareMode:$('tcm').value});if(type==='sequence')Object.assign(t,{seq:$('tseq').value.split(',').map(x=>x.trim()===''?NaN:Number(x)),missing:Number($('tmiss').value)-1});if(type==='shape')Object.assign(t,{target:$('tshape').value,shapes:Array.from({length:6},(_,i)=>$('shape'+i).value).filter(Boolean)});validateTask(t,draft);if(formTaskIndex>=0)draft.tasks[formTaskIndex]=t;else draft.tasks.push(t);$('modal').close();stopAudio();render();}catch(e){toast(e.message);}}
function publishedFor(s){const result=new Map(BOOK.map(base=>{const lesson=clone(base);lesson.version=1;lesson.builtIn=true;lesson.classId=s.classId;return [base.id,lesson];}));const scoped=db.lessons.filter(item=>(item.published||item.draft)?.classId===s.classId);const pool=scoped.length?scoped:db.lessons;for(const item of pool){const key=item.sourceKey||item.id;if(item.hidden){if(item.sourceKey)result.delete(key);continue;}if(item.published)result.set(key,item.published);}return [...result.values()].sort((a,b)=>a.order-b.order);}
function selectVolume(i){filter.volume=[...new Set(publishedFor(student).map(l=>l.volume))][i];render();}
function studentView(){if(!student)return studentLoginView();const ls=publishedFor(student),volumes=[...new Set(ls.map(l=>l.volume))],volume=volumes.includes(filter.volume)?filter.volume:volumes[0],finished=new Set(db.runs.filter(r=>r.studentId===student.id&&r.status==='complete').map(r=>r.lessonId));return `<div class="student-dashboard">${sheetPanel()}<div class="row between"><div><p class="eyebrow">${esc(className(student.classId))}</p><h2>Chào ${esc(student.name.split(' ').pop())}! 🌱</h2><p class="muted">Bạn muốn ôn bài nào cùng Thỏ?</p><p class="muted"><small>Đã có sẵn 20 bài theo SGK tập một. Chọn bài để bắt đầu ngay.</small></p></div>${btn('🥕 Hành trình của mình',"page='garden';render()",'ghost')}</div><div class="panel soft row">${rabbit(true)}<div><h3>Mỗi bài là một hạt mầm</h3><p>Bạn đã hoàn thành <b>${finished.size}</b> bài khác nhau.</p></div></div>${volumes.length?`<div class="row" style="margin-bottom:24px">${volumes.map((v,i)=>btn(esc(v),`selectVolume(${i})`,v===volume?'primary':'ghost')).join('')}</div><div class="grid lesson-grid">${ls.filter(l=>l.volume===volume).map(l=>{const active=db.runs.find(r=>r.studentId===student.id&&r.lessonId===l.id&&r.status==='active');return `<article class="card lesson-card"><span class="badge">${esc(l.volume)} · Bài ${esc(l.number)}</span><h3 style="margin-top:18px">${esc(l.title)}</h3><p class="muted">${esc(l.goal)}</p><p><small>${finished.has(l.id)?'🌿 Đã hoàn thành · có thể luyện lại':'🌱 Cùng khám phá nhé'} · ${l.tasks.length} nhiệm vụ</small></p>${btn(active?'Tiếp tục bài →':'Mở bài →',`openLesson('${l.id}')`,'primary')}</article>`;}).join('')}</div>`:'<div class="panel empty">Các bài đang được ẩn. Bạn nhờ cô giáo mở lại bài nhé!</div>'}</div>`;}
function openLesson(id){const lesson=publishedFor(student).find(l=>l.id===id);if(!lesson)return toast('Bài học hiện chưa được xuất bản.');const active=db.runs.find(r=>r.studentId===student.id&&r.lessonId===id&&r.status==='active');if(active)run=active;else{run={id:uid(),studentId:student.id,studentName:student.name,classId:student.classId,lessonId:id,version:lesson.version,lesson:clone(lesson),started:new Date().toISOString(),ended:null,status:'active',index:0,records:[],englishEvents:[],interactionMs:0};db.runs.push(run);save();}preview=false;english=db.settings.englishEnabled!==false;page='intro';touches=new Set();render();}
function previewDraft(){try{captureLesson();validateLesson(draft,false);preview=true;run={id:uid(),studentId:null,classId:draft.classId,lessonId:draft.id,version:draft.version,lesson:clone(draft),started:new Date().toISOString(),status:'active',index:0,records:[],englishEvents:[],interactionMs:0};english=db.settings.englishEnabled!==false;page='intro';touches=new Set();render();}catch(e){toast(e.message);}}
function introView(){const l=run.lesson;return `<div class="game intro-screen"><div class="intro-heading"><span class="badge">${preview?'Xem trước · không lưu kết quả':'Cùng nhớ bài'} · ${esc(l.volume)} · Bài ${esc(l.number)}</span><h2>${esc(l.title)}</h2></div><section class="play-card intro-card"><div class="intro-text">${rabbit(true)}<p>${esc(l.intro).replace(/\n/g,'<br>')}</p></div>${l.example?.length?`<div class="example-zone"><p class="muted">Chạm từng hình để đếm thử nhé!</p><div class="objects">${l.example.map((x,i)=>`<button class="object ${touches.has(i)?'counted':''}" aria-label="Đếm hình ${i+1}" onclick="touchExample(${i})">${x==='carrot'?'🥕':shapeSVG(x)}</button>`).join('')}</div><small>Bạn đã chạm ${touches.size} hình.</small></div>`:''}<div class="intro-action">${btn(run.index?'Tiếp tục chơi →':'Bắt đầu chơi →','startGame()','primary')}</div></section>${englishPanel(l)}<div class="play-bottom">${btn(preview?'← Về trình soạn':'← Về thư viện','pauseRun()','small ghost')}<span>Tiếng Anh là phần làm quen thêm.</span></div></div>`;}
function touchExample(i){touches.add(i);render();}
function startGame(){page='game';resetQuestion();render();}
function record(){let r=run.records[run.index];if(!r){r={taskId:run.lesson.tasks[run.index].id,type:run.lesson.tasks[run.index].type,attempts:0,hinted:false,assisted:false,firstCorrect:false,done:false,counted:[],answer:null};run.records[run.index]=r;}return r;}
function resetQuestion(){const rr=record(),tt=run.lesson.tasks[run.index];selected=rr.done?(tt.type==='shape'?answerOf(tt):tt.type==='puzzle'?[0,1]:[]):[];touches=new Set(rr.counted||[]);manip=rr.done&&tt.type==='operation'?tt.b:0;feedback='';locked=false;questionStart=Date.now();}
let questionStart=0;
function answerOf(t){if(t.type==='choice')return t.correct;if(t.type==='puzzle')return t.pieces;if(t.type==='split')return t.find==='total'?t.a+t.b:t.b;if(t.type==='count')return t.a;if(t.type==='sequence')return t.seq[t.missing];if(t.type==='operation')return t.op==='+'?t.a+t.b:t.a-t.b;if(t.type==='compare')return t.a>t.b?'>':t.a<t.b?'<':'=';return t.shapes.map((s,i)=>s===t.target?i:-1).filter(i=>i>=0);}
function numberChoices(t,l){const answer=answerOf(t),set=new Set([answer]);for(let d=1;set.size<4&&(answer-d>=l.min||answer+d<=l.max);d++){if(answer-d>=l.min)set.add(answer-d);if(set.size<4&&answer+d<=l.max)set.add(answer+d);}return [...set].sort((a,b)=>a-b);}
function gameView(){if(!run)return '';const l=run.lesson,t=l.tasks[run.index],r=record(),done=r.done;let visual='';if(t.type==='count'&&t.mode!=='build')visual=`<div class="objects">${Array.from({length:t.a},(_,i)=>`<button class="object ${touches.has(i)?'counted':''}" ${done?'disabled':''} aria-label="Đếm cà rốt ${i+1}" onclick="touchObject(${i})">🥕</button>`).join('')}</div><small>${t.a===0?'Giỏ đang trống.':'Chạm mỗi củ cà rốt một lần để đếm.'}</small>`;
if(t.type==='count'&&t.mode==='build')visual=`<p class="build-goal">🧺 Mục tiêu: <b>${t.a}</b> củ cà rốt</p><div class="objects">${'🥕 '.repeat(manip)}</div><div class="row" style="justify-content:center">${btn('− Bớt một','changeManip(-1)','ghost')}${btn('+ Thêm một','changeManip(1)','orange')}<b aria-live="polite">${manip} củ</b></div>`;
if(t.type==='sequence')visual=`<div class="numberline">${t.seq.map((n,i)=>`<div class="tile ${i===t.missing?'missing':''}">${i===t.missing?(done?n:'?'):n}</div>`).join('')}<span style="font-size:36px">${done?'🐰 🏠':'🐰'}</span></div>`;
if(t.type==='operation'){const total=t.op==='+'?t.a+manip:t.a;visual=`<div class="question">${t.a} ${t.op==='+'?'+':'−'} ${t.b} = ?</div><div class="objects">${Array.from({length:total},(_,i)=>`<span class="object ${t.op==='-'&&i>=t.a-manip?'removed':''}">🥕</span>`).join('')}</div><div class="row" style="justify-content:center">${btn(t.op==='+'?'Thêm 1 củ':'Bớt 1 củ','changeManip(1)','orange')}${btn('Làm lại thao tác','manip=0;render()','ghost')}<small>Đã ${t.op==='+'?'thêm':'bớt'} ${manip}/${t.b} củ</small></div>`;}
if(t.type==='compare')visual=`<div class="grid compare-groups"><div class="card soft"><strong class="stat">${t.a}</strong><div class="objects">${'🥕 '.repeat(t.a)}</div></div><div class="card blue"><strong class="stat">${t.b}</strong><div class="objects">${'🥕 '.repeat(t.b)}</div></div></div><p style="margin-top:18px">Bên trái so với bên phải thế nào?</p>`;
if(t.type==='shape')visual=`<p>Chọn tất cả ${esc(SHAPES[t.target])}.</p><div class="choices">${t.shapes.map((s,i)=>`<button class="choice ${selected.includes(i)?'selected':''}" aria-label="${esc(SHAPES[s])}, hình ${i+1}" aria-pressed="${selected.includes(i)}" ${done?'disabled':''} onclick="toggleShape(${i})">${shapeSVG(s)}</button>`).join('')}</div>`;
if(t.type==='split')visual=`<div class="grid compare-groups"><div class="card soft"><h3>Nhóm thứ nhất: ${t.a}</h3><div class="objects">${'🥕 '.repeat(t.a)}</div></div><div class="card blue"><h3>Nhóm thứ hai: ${t.find==='total'?t.b:'?'}</h3><div class="objects">${t.find==='total'?'🥕 '.repeat(t.b):'🧺'}</div></div></div><p class="question">${t.find==='total'?'Cả hai nhóm có bao nhiêu củ?':'Cả hai nhóm có '+(t.a+t.b)+' củ. Nhóm thứ hai có bao nhiêu củ?'}</p>`;if(t.type==='choice')visual=`<div class="panel soft" style="font-size:30px">${esc(t.scene||'').replace(/\n/g,'<br>')}</div>`;if(t.type==='puzzle')visual=`<p>Chạm từng mảnh bên dưới để ghép thành ${esc(SHAPES[t.target])}.</p><div class="choices">${[0,1].map(i=>`<button class="choice ${selected.includes(i)?'selected':''}" onclick="toggleShape(${i})" ${done?'disabled':''} aria-pressed="${selected.includes(i)}" aria-label="Chọn mảnh ${i+1}">${t.target==='square'?'<svg class="shape" viewBox="0 0 100 100" role="img" aria-label="Mảnh tam giác vuông"><path d="M15 15 H85 V85Z" fill="#79bac2" stroke="#2b6670" stroke-width="3"/></svg>':shapeSVG('square')}</button>`).join('')}</div><div class="puzzle-result">${puzzleSVG(t.target,selected.length)}</div><p>Đã ghép ${selected.length}/2 mảnh</p>`;let choices='';if(t.type==='puzzle')choices=done?'':btn('Kiểm tra hình ghép','submitAnswer(selected.length)','primary');else if(t.type==='choice')choices=`<div class="choices">${t.options.map((o,i)=>`<button class="choice" style="font-size:20px" ${done?'disabled':''} onclick="submitAnswer(${i})">${esc(o)}</button>`).join('')}</div>`;else if(t.type==='shape')choices=done?'':btn('Kiểm tra lựa chọn','submitAnswer(selected)','primary');else if(t.type==='count'&&t.mode==='build')choices=done?'':btn('Đủ rồi, kiểm tra nhé!','submitAnswer(manip)','primary');else {const nums=t.type==='compare'?['>','<','=']:numberChoices(t,l);choices=`<div class="choices">${nums.map(n=>{const label=t.type==='compare'&&t.compareMode!=='symbols'?({'>':'Nhiều hơn','<':'Ít hơn','=':'Bằng nhau'})[n]:n;return `<button class="choice" ${done?'disabled':''} onclick="submitAnswer(${typeof n==='number'?n:'\''+esc(n)+'\''})">${esc(label)}</button>`;}).join('')}</div>`;}
return `<div class="game play-screen"><div class="play-heading"><div><span class="badge">${preview?'Xem trước · ':''}${esc(TYPES[t.type])}</span><p class="play-lesson">Bài ${esc(l.number)} · ${esc(l.title)}</p></div><span class="step-counter">${run.index+1}<small> / ${l.tasks.length}</small></span></div><div class="progress"><div style="width:${run.index/l.tasks.length*100}%"></div></div><div class="play-layout"><section class="play-card" aria-label="Câu hỏi và đáp án"><div class="question-head"><span class="question-mark">?</span><h2>${esc(t.prompt)}</h2></div><div class="question-tools">${btn('🔊 Nghe câu hỏi','playTaskAudio()','small ghost')}${!done?btn('💡 Gợi ý','showHint()','small ghost'):''}</div><div class="visual-stage">${visual}</div><div id="feedback" aria-live="polite">${feedback?`<div class="feedback ${!done?'warn':''}">${esc(feedback)}</div>`:''}</div><div class="answer-dock" data-kind="${t.type}"><span class="answer-caption">${done?'Bạn đã hoàn thành câu này!':t.type==='shape'||t.type==='puzzle'?'Chọn hình ở trên rồi bấm kiểm tra':'Chạm đáp án của bạn'}</span>${done?btn(run.index===l.tasks.length-1?'Xem kết quả →':'Câu tiếp theo →','nextTask()','primary next-answer'):choices}</div></section><aside class="play-sidebar"><div class="companion-card">${rabbit(true)}<p>${done?'Bạn làm tốt lắm!<br>Mình cùng tiếp tục nhé.':'Cứ bình tĩnh nhé!<br>Mình luôn ở bên bạn.'}</p></div>${englishPanel(l,true,t,done,r)}<div class="side-tip">🌱 Không tính giờ.<br>Bạn có thể thử lại.</div></aside></div><div class="play-bottom">${btn(preview?'← Về trình soạn':'← Về thư viện bài','pauseRun()','small ghost')}<span>Toán vui · Mỗi lần một câu</span></div></div>`;}
function touchObject(i){if(record().done)return;touches.add(i);record().counted=[...touches];if(!preview)save();render();}
function changeManip(d){if(record().done)return;const t=run.lesson.tasks[run.index],max=t.type==='operation'?t.b:run.lesson.max;manip=Math.max(0,Math.min(max,manip+d));render();}
function toggleShape(i){selected=selected.includes(i)?selected.filter(x=>x!==i):selected.concat(i);render();}
function trackTime(){const elapsed=Date.now()-questionStart;if(questionStart&&elapsed>=0)run.interactionMs+=Math.min(elapsed,60000);questionStart=Date.now();}
function submitAnswer(answer){if(run&&run.lesson.tasks[run.index].type==='operation'&&manip!==run.lesson.tasks[run.index].b){toast('Bạn hãy thêm hoặc bớt đủ số cà rốt trước khi chọn kết quả nhé!');return;}if(locked||!run)return;const r=record();if(r.done)return;locked=true;trackTime();r.attempts++;r.answer=clone(answer);const correct=answerOf(run.lesson.tasks[run.index]),ok=Array.isArray(correct)?JSON.stringify([...answer].sort((a,b)=>a-b))===JSON.stringify(correct):answer===correct;if(ok){r.done=true;r.firstCorrect=r.attempts===1&&!r.hinted;r.assisted=r.hinted||r.attempts>1;feedback=r.assisted?'Bạn đã hoàn thành! Cùng nhớ lại cách làm nhé.':'Đúng rồi! Bạn làm tốt lắm!';}else{r.firstCorrect=false;feedback=r.attempts>=2?'Mình cùng xem gợi ý rồi thử lại nhé!':'Bạn thử lại nhé. Mình cùng quan sát kỹ hơn nào!';if(r.attempts>=2){r.hinted=true;feedback=hintText(run.lesson.tasks[run.index]);}}if(!preview)save();locked=false;render();}
function hintText(t){if(t.hint)return t.hint;if(t.type==='choice')return 'Quan sát thứ tự và vị trí trong hình, sau đó đọc lại yêu cầu.';if(t.type==='puzzle')return 'Chạm lần lượt hai mảnh; quan sát cách chúng khớp trong hình đích.';if(t.type==='split')return t.find==='total'?'Đếm nhóm thứ nhất, đếm tiếp nhóm thứ hai để biết cả hai nhóm.':'Đếm từ nhóm đã biết đến số lượng của cả hai nhóm để tìm số còn thiếu.';if(t.type==='count')return 'Chạm và đếm lần lượt từng củ cà rốt, mỗi củ một lần. Giỏ trống có 0 củ.';if(t.type==='sequence'){const step=t.seq[1]-t.seq[0];return 'Quan sát các số liền nhau: mỗi bước '+(step>0?'tăng':'giảm')+' '+Math.abs(step)+'. Bạn hãy tìm số ở ô trống.';}if(t.type==='operation')return t.op==='+'?'Giữ số cà rốt ban đầu, thêm đủ số được yêu cầu rồi đếm tất cả.':'Từ số cà rốt ban đầu, bớt đúng số được yêu cầu rồi đếm số còn lại.';if(t.type==='compare')return 'Đếm hai nhóm hoặc ghép mỗi củ bên trái với một củ bên phải. Bên nào còn dư thì nhiều hơn.';return {circle:'Tìm hình có đường bao cong tròn, không có góc.',triangle:'Tìm hình có 3 cạnh và 3 góc.',square:'Tìm hình có 4 cạnh bằng nhau và 4 góc vuông.',cube:'Tìm khối có các mặt đều là hình vuông bằng nhau.',cuboid:'Tìm khối dạng hộp dài, khác khối lập phương trong các hình này.',rectangle:'Tìm hình chữ nhật nằm ngang có 4 góc vuông. Trong trò này, hình vuông được chọn riêng theo tên đã học.'}[t.target];}
function showHint(){if(record().done)return;trackTime();record().hinted=true;feedback=hintText(run.lesson.tasks[run.index]);if(record().attempts>=3)feedback+=' Đáp án để cùng kiểm tra: '+displayAnswer(run.lesson.tasks[run.index])+'. Bạn hãy chọn lại đáp án đó.';if(!preview)save();render();}
function displayAnswer(t){const a=answerOf(t);if(t.type==='choice')return t.options[a];if(t.type==='puzzle')return 'ghép đủ hai mảnh';if(Array.isArray(a))return 'các hình số '+a.map(x=>x+1).join(', ');if(t.type==='compare')return ({'>':'bên trái nhiều hơn','<':'bên trái ít hơn','=':'hai bên bằng nhau'})[a];return String(a);}
function nextTask(){if(!record().done)return;if(run.index<run.lesson.tasks.length-1){run.index++;if(!preview)save();resetQuestion();render();}else{run.status='complete';run.ended=new Date().toISOString();if(!preview)save();page='result';render();}}
function pauseRun(){trackTime();if(preview){run=null;preview=false;page='teacher';tab='editor';render();}else{save();run=null;page='student';render();}}
function playTaskAudio(){const t=run.lesson.tasks[run.index];if(!t.audioApproved)return toast('Chưa có âm thanh được duyệt. Bạn đọc yêu cầu hoặc nhờ cô hướng dẫn nhé.');stopAudio();if(t.audio){currentAudio=new Audio(t.audio);currentAudio.play().catch(()=>toast('Không phát được bản thu trên thiết bị này.'));}else speak(t.prompt,'vi',t.voice);}
function playEnglish(){if(!run||!english)return;const items=englishItems(run.lesson);if(items.length)playEnglishWord(run.index%items.length);}
function metrics(r){return {answered:r.records.filter(x=>x.attempts>0).length,first:r.records.filter(x=>x.firstCorrect).length,hints:r.records.filter(x=>x.hinted).length,supported:r.records.filter(x=>x.done&&x.assisted).length,done:r.records.filter(x=>x.done).length,total:r.lesson.tasks.length};}
function resultView(){const m=metrics(run),l=run.lesson;return `<div class="game"><div class="rabbit-stage">${rabbit()}<div class="bubble">${esc(db.settings.praise)}</div></div><h2 style="margin-top:24px">Một hạt mầm mới trong khu vườn! 🌱</h2><p>${esc(l.title)} · ${preview?'Xem trước, không lưu kết quả':'Đã hoàn thành'}</p><div class="grid"><div class="card"><div class="stat">${m.first}/${m.total}</div>Đúng lần đầu</div><div class="card"><div class="stat">${m.supported}</div>Hoàn thành sau hỗ trợ</div><div class="card"><div class="stat">${m.done}/${m.total}</div>Nhiệm vụ hoàn thành</div></div><div class="panel" style="margin-top:24px;text-align:left"><h3>Mình cùng nhớ</h3><p>${esc(l.recap)}</p>${english&&englishItems(l).length?'<div class="feedback blue"><span lang="en">Well done!</span> — Bạn làm tốt lắm!<br><small>Tiếng Anh là phần làm quen, không tính vào kết quả Toán.</small></div>':''}${l.outside?`<hr class="hr"><h3>Thử ngoài màn hình</h3><p>${esc(l.outside)}</p>`:''}</div><div class="row" style="justify-content:center">${preview?btn('Về trình soạn','pauseRun()','primary'):btn('Về thư viện bài',"run=null;page='student';render()",'primary')}${!preview?btn('Luyện lại bài này',`replay('${l.id}')`,'ghost'):''}${!preview?btn('Xem khu vườn',"run=null;page='garden';render()",'ghost'):''}</div>${sheetPanel()}</div>`;}
function replay(id){run=null;openLesson(id);}
function gardenView(){const completed=db.runs.filter(r=>r.studentId===student.id&&r.status==='complete'),unique=[...new Map(completed.map(r=>[r.lessonId,r])).values()],n=unique.length;return `<h2>Khu vườn của ${esc(student.name.split(' ').pop())} 🥕</h2><p class="muted">${n} bài khác nhau đã hoàn thành · ${completed.length} lượt hoàn thành.</p><div class="panel soft"><h3>Huy hiệu của bạn</h3><div class="row">${db.settings.milestones.map(m=>`<span class="badge ${n>=m?'':'pill'}">${n>=m?'🏅':'🌱'} ${m} bài ${n>=m?'· đã đạt':''}</span>`).join('')}</div></div><div class="panel">${unique.length?`<div class="garden">${unique.map(r=>`<div class="plant"><b>🥕</b><strong>Bài ${esc(r.lesson.number)}</strong><br><small>${esc(r.lesson.title)}</small></div>`).join('')}</div>`:'<div class="empty">Khu vườn đang chờ hạt mầm đầu tiên. Mình cùng mở một bài học nhé!</div>'}</div>${sheetPanel()}${btn('Về thư viện bài',"page='student';render()",'primary')}`;}
function filteredRuns(){return db.runs.filter(r=>(!filter.classId||r.classId===filter.classId)&&(!filter.studentId||r.studentId===filter.studentId)&&(!filter.volumeR||r.lesson.volume===filter.volumeR)&&(!filter.lessonId||r.lessonId===filter.lessonId)&&(!filter.from||r.started.slice(0,10)>=filter.from)&&(!filter.to||r.started.slice(0,10)<=filter.to)&&(!filter.skill||r.lesson.tasks.some(t=>t.type===filter.skill)));}
function resultsView(){const rows=filteredRuns(),vols=[...new Set(db.runs.map(r=>r.lesson.volume))],lessons=[...new Map(db.runs.map(r=>[r.lessonId,r.lesson])).values()],tot=rows.reduce((a,r)=>{const m=metrics(r);a.total+=m.total;a.first+=m.first;a.done+=m.done;return a;},{total:0,first:0,done:0}),diff={};rows.forEach(r=>r.records.filter(x=>x.hinted||x.attempts>1).forEach(x=>diff[x.type]=(diff[x.type]||0)+1));return `<h2>Theo dõi kết quả</h2><div class="notice">Bảng chi tiết dưới đây dùng dữ liệu của trình duyệt này. Khi học sinh bấm Gửi kết quả, bản tổng hợp được gửi tới tab KET QUA. Thời điểm trong bảng chi tiết lấy từ đồng hồ thiết bị; thời gian tương tác là ước tính. Lượt nghe tiếng Anh chỉ thể hiện mức tham gia.</div><div class="panel"><div class="inlineform"><label>Lớp<select onchange="filter.classId=this.value;render()">${classOptions(filter.classId||'',true)}</select></label><label>Học sinh<select onchange="filter.studentId=this.value;render()"><option value="">Tất cả học sinh</option>${db.students.map(s=>`<option value="${s.id}" ${filter.studentId===s.id?'selected':''}>${esc(s.name)}</option>`).join('')}</select></label><label>Tập<select onchange="filter.volumeR=this.value;render()"><option value="">Tất cả tập</option>${vols.map(v=>`<option ${filter.volumeR===v?'selected':''}>${esc(v)}</option>`).join('')}</select></label><label>Bài<select onchange="filter.lessonId=this.value;render()"><option value="">Tất cả bài</option>${lessons.map(l=>`<option value="${l.id}" ${filter.lessonId===l.id?'selected':''}>${esc(l.volume)} · ${esc(l.number)} · ${esc(l.title)}</option>`).join('')}</select></label><label>Kỹ năng<select onchange="filter.skill=this.value;render()"><option value="">Tất cả kỹ năng</option>${Object.entries(TYPES).map(([k,v])=>`<option value="${k}" ${filter.skill===k?'selected':''}>${v}</option>`).join('')}</select></label><label>Từ ngày<input type="date" value="${filter.from||''}" onchange="filter.from=this.value;render()"></label><label>Đến ngày<input type="date" value="${filter.to||''}" onchange="filter.to=this.value;render()"></label></div><small>Lọc kỹ năng chọn các lượt có game đó; tổng quan vẫn tính toàn bộ nhiệm vụ của các lượt được chọn.</small></div><div class="grid"><div class="card"><div class="stat">${rows.length}</div>Lượt học</div><div class="card"><div class="stat">${rows.length?tot.first+'/'+tot.total:'—'}</div>Đúng lần đầu / tổng nhiệm vụ được giao</div><div class="card"><div class="stat">${rows.filter(r=>r.status==='complete').length}</div>Lượt hoàn thành</div></div><div class="panel" style="margin-top:20px"><h3>Lịch sử lượt học</h3>${rows.length?`<div class="table-wrap"><table><thead><tr><th>Học sinh / lớp</th><th>Bài / phiên bản</th><th>Thời điểm</th><th>Trạng thái</th><th>Đã trả lời</th><th>Đúng lần đầu</th><th>Cần gợi ý</th><th>Sau hỗ trợ</th><th>Nghe Anh</th><th></th></tr></thead><tbody>${rows.slice().reverse().map(r=>{const m=metrics(r);return `<tr><td>${esc(db.students.find(s=>s.id===r.studentId)?.name||r.studentName)}<br><small>${esc(className(r.classId))}</small></td><td>${esc(r.lesson.volume)} · ${esc(r.lesson.number)}<br><small>${esc(r.lesson.title)} · v${r.version}</small></td><td>${date(r.started)}</td><td>${r.status==='complete'?'Hoàn thành':'Đang học'}</td><td>${m.answered}/${m.total}</td><td>${m.first}/${m.total}</td><td>${m.hints}</td><td>${m.supported}</td><td>${r.englishEvents.length}</td><td>${btn('Chi tiết',`runDetails('${r.id}')`,'small ghost')}</td></tr>`;}).join('')}</tbody></table></div>`:'<div class="empty">Chưa có dữ liệu phù hợp.</div>'}</div><div class="panel"><h3>Kỹ năng có lần thử lại hoặc dùng gợi ý</h3>${Object.keys(diff).length?Object.entries(diff).map(([k,n])=>`<p>${TYPES[k]}: <b>${n} nhiệm vụ</b></p>`).join(''):'<p class="muted">Chưa có dữ liệu ghi nhận khó khăn.</p>'}<small>Đây là số nhiệm vụ có hỗ trợ hoặc thử lại, không phải kết luận về năng lực.</small></div>`;}
function runDetails(id){const r=db.runs.find(x=>x.id===id);$('modal').innerHTML=`<h2>Chi tiết lượt học</h2><p>${esc(r.studentName)} · ${esc(r.lesson.title)}</p><p class="muted">Bắt đầu: ${date(r.started)}<br>Kết thúc: ${date(r.ended)}<br>Tương tác ước tính: ${Math.round(r.interactionMs/1000)} giây</p>${r.lesson.tasks.map((t,i)=>{const a=r.records[i];return `<div class="taskcard"><b>${i+1}. ${esc(t.prompt)}</b><p>${!a||!a.attempts?'Chưa trả lời':`${a.attempts} lần trả lời · ${a.done?'Đã hoàn thành':'Chưa hoàn thành'} · ${a.hinted?'Có gợi ý':'Chưa dùng gợi ý'}`}</p></div>`;}).join('')}${btn('Đóng',"$('modal').close()",'primary')}`;$('modal').showModal();}
function settingsView(){return `<h2>Cài đặt người bạn đồng hành</h2><div class="cols"><form class="panel" onsubmit="saveSettings(event)">${field('Tên nhân vật','setName',db.settings.name)}<label>Lời chào<textarea id="setGreet">${esc(db.settings.greeting)}</textarea></label><label>Lời động viên cuối bài<textarea id="setPraise">${esc(db.settings.praise)}</textarea></label><label>Màu nhấn<select id="setColor">${[['#29775c','Xanh lá dịu'],['#28647b','Xanh da trời đậm'],['#8d4c2d','Cam đất']].map(([c,n])=>`<option value="${c}" ${db.settings.color===c?'selected':''}>${n}</option>`).join('')}</select></label>${field('Mốc huy hiệu (cách nhau dấu phẩy)','setBadges',db.settings.milestones.join(', '))}<label>Ảnh nhân vật (PNG/JPG/WebP, tối đa 500 KB)<input type="file" accept="image/png,image/jpeg,image/webp" onchange="setRabbitImage(this)"></label><div class="row" style="margin-top:15px"><button class="primary">Lưu cài đặt</button><button type="button" class="ghost" onclick="db.settings.image='';save();render()">Dùng Thỏ gốc</button></div></form><section><div class="panel soft" style="text-align:center">${rabbit()}<h3>${esc(db.settings.name)}</h3></div><div class="panel"><h3>Thông tin phiên bản</h3><p>Lưu trên trình duyệt hiện tại. Đã có gửi bản tổng hợp tới Google Sheets của cô bằng Apps Script. Hồ sơ chi tiết vẫn lưu trên thiết bị, chưa có đồng bộ giữa các thiết bị hoặc API AI.</p><p>Giọng đọc phụ thuộc trình duyệt và có thể cần mạng. Không có quảng cáo, không yêu cầu micro.</p><p class="muted">Xóa dữ liệu trình duyệt có thể làm mất hồ sơ và kết quả. Không chuyển file HTML sang thiết bị khác kèm dữ liệu đã lưu.</p><button class="danger" onclick="clearLearningData()">Xóa dữ liệu học tập trên thiết bị</button></div></section></div>`;}
function saveSettings(e){e.preventDefault();const milestones=$('setBadges').value.split(',').map(x=>Number(x.trim()));if(!milestones.length||milestones.some(x=>!Number.isInteger(x)||x<1||x>1000))return toast('Mốc huy hiệu phải là số nguyên từ 1 đến 1000.');if(!$('setName').value.trim())return toast('Nhập tên nhân vật.');Object.assign(db.settings,{name:$('setName').value.trim(),greeting:$('setGreet').value.trim(),praise:$('setPraise').value.trim(),color:$('setColor').value,milestones:[...new Set(milestones)].sort((a,b)=>a-b)});if(save())toast('Đã lưu cài đặt.');render();}
function setRabbitImage(input){const f=input.files[0];if(!f)return;if(f.size>500*1024||!['image/png','image/jpeg','image/webp'].includes(f.type))return toast('Chỉ nhận PNG, JPG, WebP tối đa 500 KB.');const r=new FileReader();r.onload=()=>{db.settings.image=r.result;if(save())toast('Đã lưu ảnh nhân vật.');render();};r.readAsDataURL(f);}
function clearLearningData(){if(!teacher)return;if(!confirm('Xóa toàn bộ lớp, hồ sơ học sinh, bài học và kết quả trên thiết bị? Không thể hoàn tác.'))return;const value=prompt('Gõ XOA để xác nhận xóa:');if(value!=='XOA')return;const t=db.teacher,s=db.settings;db=fresh();db.teacher=t;db.settings=s;filter={};save();tab='overview';render();}
if('speechSynthesis' in window){speechSynthesis.getVoices();}
const BOOK=[{"id":"sgk-t1-1","book":"Toán 1 – Kết nối tri thức với cuộc sống","edition":"Theo bản PDF giáo viên cung cấp","volume":"Tập 1","number":"1","title":"Các số 0, 1, 2, 3, 4, 5","pages":"8–13","order":1,"classId":"","min":0,"max":5,"goal":"Đếm mỗi đồ vật một lần; không có đồ vật nào thì dùng số 0.","intro":"Các số từ 0 đến 5 cho biết số lượng đồ vật. Giỏ trống có 0 củ cà rốt. Chạm lần lượt 3 củ: một, hai, ba. Có 3 củ.","recap":"Đếm mỗi đồ vật một lần; không có đồ vật nào thì dùng số 0.","outside":"Tìm và đếm một số đồ vật hoặc hình tương tự quanh bạn. Nhờ cô hướng dẫn nếu cần.","english":[{"en":"Let’s count!","vi":"Cùng đếm nào!"}],"englishApproved":false,"tasks":[{"type":"count","a":0,"mode":"choose","prompt":"Đếm số cà rốt rồi chọn số phù hợp.","id":"sgk1-1-1","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"count","a":2,"mode":"choose","prompt":"Đếm số cà rốt rồi chọn số phù hợp.","id":"sgk1-1-2","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"count","a":4,"mode":"choose","prompt":"Đếm số cà rốt rồi chọn số phù hợp.","id":"sgk1-1-3","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"count","a":5,"mode":"build","prompt":"Cho đủ 5 củ cà rốt vào giỏ.","id":"sgk1-1-4","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"sequence","seq":[0,1,2,3,4,5],"missing":2,"prompt":"Tìm số còn thiếu để giúp Thỏ về nhà.","id":"sgk1-1-5","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"sequence","seq":[0,1,2,3,4,5],"missing":4,"prompt":"Tìm số còn thiếu để giúp Thỏ về nhà.","id":"sgk1-1-6","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""}],"example":["carrot","carrot","carrot"],"version":0,"source":"SGK Toán 1, tập một-mau.pdf; mục lục trang 4–5. Nhiệm vụ được biên soạn mới để ôn tập."},{"id":"sgk-t1-2","book":"Toán 1 – Kết nối tri thức với cuộc sống","edition":"Theo bản PDF giáo viên cung cấp","volume":"Tập 1","number":"2","title":"Các số 6, 7, 8, 9, 10","pages":"14–19","order":2,"classId":"","min":0,"max":10,"goal":"Đếm lần lượt để xác định số lượng trong phạm vi 10.","intro":"Đếm tiếp sau 5: sáu, bảy, tám, chín, mười. Mỗi số cho biết số lượng của một nhóm đồ vật.","recap":"Đếm lần lượt để xác định số lượng trong phạm vi 10.","outside":"Tìm và đếm một số đồ vật hoặc hình tương tự quanh bạn. Nhờ cô hướng dẫn nếu cần.","english":[{"en":"Let’s count!","vi":"Cùng đếm nào!"}],"englishApproved":false,"tasks":[{"type":"count","a":6,"mode":"choose","prompt":"Đếm số cà rốt rồi chọn số phù hợp.","id":"sgk1-2-1","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"count","a":8,"mode":"choose","prompt":"Đếm số cà rốt rồi chọn số phù hợp.","id":"sgk1-2-2","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"count","a":10,"mode":"choose","prompt":"Đếm số cà rốt rồi chọn số phù hợp.","id":"sgk1-2-3","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"count","a":7,"mode":"build","prompt":"Cho đủ 7 củ cà rốt vào giỏ.","id":"sgk1-2-4","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"sequence","seq":[6,7,8,9,10],"missing":2,"prompt":"Tìm số còn thiếu để giúp Thỏ về nhà.","id":"sgk1-2-5","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"sequence","seq":[6,7,8,9,10],"missing":3,"prompt":"Tìm số còn thiếu để giúp Thỏ về nhà.","id":"sgk1-2-6","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""}],"example":["carrot","carrot","carrot"],"version":0,"source":"SGK Toán 1, tập một-mau.pdf; mục lục trang 4–5. Nhiệm vụ được biên soạn mới để ôn tập."},{"id":"sgk-t1-3","book":"Toán 1 – Kết nối tri thức với cuộc sống","edition":"Theo bản PDF giáo viên cung cấp","volume":"Tập 1","number":"3","title":"Nhiều hơn, ít hơn, bằng nhau","pages":"20–23","order":3,"classId":"","min":0,"max":10,"goal":"So sánh số lượng bằng cách đếm hoặc ghép từng cặp.","intro":"Ghép mỗi củ cà rốt ở một nhóm với một củ ở nhóm kia. Nhóm còn dư có nhiều hơn. Ghép vừa hết cả hai nhóm thì bằng nhau.","recap":"So sánh số lượng bằng cách đếm hoặc ghép từng cặp.","outside":"Tìm và đếm một số đồ vật hoặc hình tương tự quanh bạn. Nhờ cô hướng dẫn nếu cần.","english":[{"en":"Let’s count!","vi":"Cùng đếm nào!"}],"englishApproved":false,"tasks":[{"type":"compare","a":3,"b":5,"compareMode":"words","prompt":"So sánh hai nhóm cà rốt.","id":"sgk1-3-1","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"compare","a":6,"b":4,"compareMode":"words","prompt":"So sánh hai nhóm cà rốt.","id":"sgk1-3-2","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"compare","a":4,"b":4,"compareMode":"words","prompt":"So sánh hai nhóm cà rốt.","id":"sgk1-3-3","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"compare","a":7,"b":8,"compareMode":"words","prompt":"So sánh hai nhóm cà rốt.","id":"sgk1-3-4","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"compare","a":5,"b":2,"compareMode":"words","prompt":"So sánh hai nhóm cà rốt.","id":"sgk1-3-5","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"compare","a":0,"b":0,"compareMode":"words","prompt":"So sánh hai nhóm cà rốt.","id":"sgk1-3-6","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""}],"example":[],"version":0,"source":"SGK Toán 1, tập một-mau.pdf; mục lục trang 4–5. Nhiệm vụ được biên soạn mới để ôn tập."},{"id":"sgk-t1-4","book":"Toán 1 – Kết nối tri thức với cuộc sống","edition":"Theo bản PDF giáo viên cung cấp","volume":"Tập 1","number":"4","title":"So sánh số","pages":"24–31","order":4,"classId":"","min":0,"max":10,"goal":"Dùng dấu >, <, = phù hợp giữa hai số.","intro":"Số 3 bé hơn 5, viết 3 < 5. Số 5 lớn hơn 3, viết 5 > 3. Hai số giống n