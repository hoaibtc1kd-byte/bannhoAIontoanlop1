t cả để tìm kết quả phép cộng.","outside":"Tìm và đếm một số đồ vật hoặc hình tương tự quanh bạn. Nhờ cô hướng dẫn nếu cần.","english":[{"en":"Well done!","vi":"Bạn làm tốt lắm!"}],"englishApproved":false,"tasks":[{"type":"operation","a":1,"b":2,"op":"+","prompt":"Thêm cà rốt rồi chọn kết quả.","id":"sgk1-10-1","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"operation","a":3,"b":2,"op":"+","prompt":"Thêm cà rốt rồi chọn kết quả.","id":"sgk1-10-2","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"operation","a":4,"b":3,"op":"+","prompt":"Thêm cà rốt rồi chọn kết quả.","id":"sgk1-10-3","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"operation","a":5,"b":4,"op":"+","prompt":"Thêm cà rốt rồi chọn kết quả.","id":"sgk1-10-4","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"operation","a":0,"b":6,"op":"+","prompt":"Thêm cà rốt rồi chọn kết quả.","id":"sgk1-10-5","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""},{"type":"operation","a":6,"b":4,"op":"+","prompt":"Thêm cà rốt rồi chọn kết quả.","id":"sgk1-10-6","hint":"","audio":"","audioApproved":false,"audioRequired":false,"voice":""}],"example":["carrot","carrot","carrot"],"version":0,"source":"SGK Toán 1, tập một-mau.pdf; mục lục trang 4–5. Nhiệm vụ được biên soạn mới để ôn tập."},{"id":"sgk-t1-11","book":"Toán 1 – Kết nối tri thức với cuộc sống","edition":"Theo bản PDF giáo viên cung cấp","volume":"Tập 1","number":"11","title":"Phép trừ trong phạm vi 10","pages":"68–79","order":11,"classId":"","min":0,"max":10,"goal":"Bớt đi rồi đếm số còn lại để tìm kết quả phép trừ.","intro":"Có 5 củ cà rốt, bớt 2 củ. Đếm số còn lại được 3 củ. Ta viết 5 − 2 = 3.","recap":"Bớt đi rồi đếm số còn lại để tìm kết quả phép trừ.","outside":"Tìm và đếm một số đồ vật hoặc hình tương tự quanh bạn. Nhờ cô hướng dẫn nếu cần.","english":[{"en":"Well done!","vi":"Bạn làm tốt l